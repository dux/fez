<!-- generated from src: docs_src/root/fez/ui-tags.fez | DO NOT EDIT OR READ THIS FILE -->
<info>
  <ul>
    <li>Tag list - add through a form, remove with a click</li>
    <li>Initial list comes from <code>PROPS</code>: <code>tags="a, b"</code> is split into an Array and copied to state</li>
    <li><code>onSubmit()</code> receives parsed form data, no <code>FormData</code> plumbing</li>
    <li>Keyed <code>{#each}</code> with an <code>{:else}</code> empty state</li>
    <li>Chips fly in, fade out and glide to place with <code>fez:animate="flip"</code></li>
  </ul>
</info>

<demo>
  <ui-tags tags="state, transitions, no build"></ui-tags>
</demo>

<script>
  PROPS = {
    tags: {
      type: Array,
      state: true,
      default: (raw) => (raw || '').split(/\s*,\s*/).filter(Boolean),
    },
  }

  onSubmit({ tag }) {
    this.state.tags = [tag, ...this.state.tags]
    this.find('form').reset()
  }

  remove(tag) {
    this.state.tags = this.state.tags.filter(t => t != tag)
  }
</script>

<style>
  display: grid;
  gap: 12px;
  width: 100%;

  form {
    display: flex;
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 8px 11px;
    font: inherit;
    border: 1px solid #d8d8d8;
    border-radius: 8px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    background: #f1f1f4;
    font-size: 14px;

    button {
      border: none;
      background: none;
      color: #999;
      font-size: 15px;
      line-height: 1;
      cursor: pointer;
      padding: 0;
    }

    button:hover {
      color: #c0113a;
    }

    &.empty {
      background: none;
      color: #999;
      font-style: italic;
    }
  }
</style>

<form><input name="tag" placeholder="add a tag" required /></form>

<ul>
  {#each state.tags as tag}
    <li key={tag} fez:animate="flip"
        fez:in="fly, from=left" fez:out="scale, duration=150">
      {tag} <button onclick={() => remove(tag)}>&times;</button>
    </li>
  {:else}
    <li class="empty">no tags - add one</li>
  {/each}
</ul>
