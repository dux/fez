</xmp>

<xmp fez="site-live">
  <!--
    Browser-chrome card used on the home page.
    <site-live title="index.html" right-title="fez.js · ~35KB gzip"> ... </site-live>
    Everything between the tags is rendered below the title bar, unwrapped.
  -->
  <div class="bar">
    <i></i><i></i><i></i> {props.title}
    {#if props['right-title']}
      <span class="tag">{props['right-title']}</span>
    {/if}
  </div>
  <slot unwrap />

  <style>
    border: 1px solid var(--line); border-radius: var(--r); background: #fff;
    box-shadow: var(--shadow); overflow: hidden;

    .bar {
      display: flex; align-items: center; gap: 8px; padding: 10px 14px;
      border-bottom: 1px solid var(--line); background: #fff;
      font: 12.5px var(--font-mono); color: var(--ink-2);

      i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-2); display: inline-block; }
      i:first-child { background: var(--fez); }
      .tag { margin-left: auto; color: var(--ink-3); white-space: nowrap; font-size: 11.5px; }
    }

    pre { max-width: 100%; overflow-x: auto; }

    .src {
      pre { margin: 0; background: transparent; overflow-x: auto; }
      xmp { display: none; }
      .fez-ui-editor pre { margin: 0; border: none; }
      .fez-ui-editor code { font-size: 13.5px; line-height: 1.55; padding: 14px 18px; display: block; border: none; border-radius: 0; }
    }

    .out { padding: 22px 18px 18px 18px; border-top: 1px dashed var(--line-2); display: flex; align-items: center; justify-content: center; }

    /* how the tag is used in the page - sits above the live output, not in the code */
    .out-usage {
      font: 12px var(--font-mono); color: var(--ink-3);
      border-top: 1px dashed var(--line-2);
      padding: 12px 18px 0 18px;
    }

    .out-usage + .out { border-top: none; padding-top: 14px; }

    .out-label {
      font: 12px var(--font-mono); color: var(--ink-3); text-transform: none;
      padding: 0 18px 12px 18px;
    }
  </style>
</xmp>

<xmp fez="site-copy">
  <script>
    class {
      copy() {
        const text = this.props.text || this.root.previousElementSibling?.innerText || ''
        navigator.clipboard?.writeText(text).then(
          () => Toast.info('Copied.'),
          () => Toast.error('Could not copy.')
        )
      }
    }
  </script>

  <button onclick="fez.copy()"><slot /></button>
</xmp>

<xmp fez="site-toc">
  <script>
    class {
      NAME = 'nav'

      init() {
        this.state.items = []
        const name = location.pathname.replace(/\/+$/, '').split('/').pop() || 'index.html'
        this.state.file = name.includes('.') ? name : 'index.html'
      }

      onMount() {
        // the markdown next to us renders async (marked is an ESM import), poll until headings exist
        const poll = this.setInterval(() => {
          const root = document.querySelector(this.props.for)
          const heads = root ? [...root.querySelectorAll('h2, h3')] : []
          if (!heads.length) return
          clearInterval(poll)
          this.state.items = heads.map(h => {
            if (!h.id) h.id = 'h-' + h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
            return { id: h.id, text: h.textContent, level: h.tagName.toLowerCase() }
          })
          this.on('scroll', this.updateActive, { throttle: 80 })
          this.updateActive()
        }, 150)
      }

      updateActive() {
        const top = window.scrollY + 100
        let active = null
        for (const item of this.state.items) {
          const node = document.getElementById(item.id)
          if (node && node.offsetTop <= top) active = item.id
        }
        if (active !== this.state.active) this.state.active = active
      }
    }
  </script>

  <div class="site-toc">
    {#each state.items as item}
      <a href="{state.file}#{item.id}" class="{item.level} {item.id == state.active ? 'active' : ''}">{item.text}</a>
    {/each}
  </div>
</xmp>

<xmp fez="site-markdown">
  <script>
    import { marked } from 'https://cdn.jsdelivr.net/npm/marked/lib/marked.esm.js'
    import hljs from 'https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/es/highlight.min.js'


    class {
      NAME = 'article'

      init(props) {
        this.root.classList.add('markdown')
        Fez.fetch(props.src, (text) => {
          // Changelog files keep portable YAML frontmatter; marked should render only the entry body.
          text = text.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n/, '')
          // README paths are repo-root relative; the generated site is the ./docs folder
          text = text
            .replaceAll('src="docs/', 'src="./')
            .replaceAll('](docs/', '](./')
            .replaceAll('](./docs/', '](./')
          this.root.innerHTML = marked.parse(text)
          this.root.querySelectorAll('pre code').forEach(node => hljs.highlightElement(node))
          // stable ids for the toc / deep links
          this.root.querySelectorAll('h1, h2, h3, h4').forEach(h => {
            h.id ||= 'h-' + h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
          })
          if (location.hash) document.getElementById(location.hash.slice(1))?.scrollIntoView()
        })
      }
    }
  </script>
</xmp>
