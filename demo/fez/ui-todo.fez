<info>
  <ul>
    <li>Classic Todo app demo - add, complete, clear tasks</li>
    <li>Pure Fez, no external dependencies</li>
    <li>Showcases reactive state, <code>fez:bind</code>, and template loops</li>
    <li>Rows slide in/out with <code>fez:in</code> / <code>fez:out</code>, remaining rows glide via <code>fez:animate="flip"</code></li>
  </ul>
</info>

<demo>
  <ui-todo></ui-todo>
</demo>

<script>
  clearCompleted() {
    this.state.tasks = this.state.tasks.filter((t) => !t.done)
  }

  removeTask(index) {
    this.state.tasks = this.state.tasks.filter((_, i) => i !== index);
  }

  addTask() {
    // no need to force update template, this is automatic because we are using reactiveStore()
    // the new row animates in on its own (fez:in on the <p>)
    this.state.tasks.push({
      id: ++this.local.uid,
      name: `new task ${this.local.uid}`,
      done: false,
    })
  }

  init() {
    this.local.uid = 3
    this.state.tasks = [
      {id: 1, name: 'First task', done: false},
      {id: 2, name: 'Second task', done: false},
      {id: 3, name: 'Third task', done: true },
    ]
  }
</script>

<h3>Tasks</h3>
{#if !state.tasks[0]}
  <p fez:in="fade">No tasks found</p>
{/if}

{#for task, index in state.tasks}
  <p
    key="{task.id}"
    fez:in="slide, opacity=0, duration=200"
    fez:out="slide, opacity=0, duration=200"
    fez:animate="flip, duration=200"
  >
    <input
      type="text"
      fez:bind="state.tasks[{index}].name"
      style="{task.done ? 'background-color: #ccc;' : ''}"
    />
    &sdot;
    <input
      type="checkbox"
      fez:bind="state.tasks[{index}].done"
    />
    &sdot;
    <button onclick="fez.removeTask({index})">&times;</button>
  </p>
{/for}
<p>
  <button onclick="fez.addTask()">add task</button>
  &sdot;
  <button onclick="fez.clearCompleted()">clear completed</button>
</p>
<pre class="code">{JSON.stringify(state.tasks, null, 2)}</pre>
<p>If you want to preserve state in templates, use "fez:keep" attribute</p>
<p>Refresh: {Math.random()}</p>
<p fez:keep="rand">
  Do not refresh: {Math.random()}.
  <br />
  <ui-star color="#FF6B6B" fill="50" size="24"></ui-star>
  Star is rendered only once
</p>
