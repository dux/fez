{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/tc39-proposal-scope-mapping/refs/heads/main/schemas/vscode/tmLanguage.schema.json",
  "name": "Fez",
  "scopeName": "source.fez",
  "fileTypes": ["fez", "fez.html"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#script-ts-block" },
    { "include": "#script-block" },
    { "include": "#style-block" },
    { "include": "#head-block" },
    { "include": "#info-block" },
    { "include": "#demo-block" },
    { "include": "#slim-block" },
    { "include": "#slim-template" },
    { "include": "#template" }
  ],
  "repository": {
    "comment": {
      "begin": "<!--",
      "end": "-->",
      "name": "comment.block.html.fez",
      "captures": {
        "0": { "name": "punctuation.definition.comment.html.fez" }
      }
    },
    "script-block": {
      "begin": "^\\s*(<)(script)(\\b[^>]*)(>)",
      "end": "^\\s*(</)(script)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.script.html.fez" },
        "3": {
          "patterns": [{ "include": "#html-attributes" }]
        },
        "4": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.script.html.fez" },
        "3": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "contentName": "source.js",
      "patterns": [
        { "include": "#fez-class-block" },
        { "include": "source.js" }
      ]
    },
    "fez-class-block": {
      "begin": "^([ \\t]*)(class)\\s*(\\{)\\s*$",
      "end": "^\\1(\\})",
      "beginCaptures": {
        "2": { "name": "storage.type.class.fez" },
        "3": { "name": "punctuation.definition.block.js" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.js" }
      },
      "patterns": [
        { "include": "#fez-class-properties" },
        { "include": "source.js" }
      ]
    },
    "fez-class-properties": {
      "patterns": [
        {
          "match": "\\b(FAST|META|NAME|PROPS|MOUNT|GLOBAL)\\b",
          "name": "variable.other.constant.fez"
        },
        {
          "match": "\\b(init|onMount|onDestroy|beforeRender|onWindowResize|onWindowScroll|onRefresh)\\b",
          "name": "entity.name.function.lifecycle.fez"
        }
      ]
    },
    "style-block": {
      "begin": "^\\s*(<)(style)(\\b[^>]*)(>)",
      "end": "^\\s*(</)(style)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.style.html.fez" },
        "3": {
          "patterns": [{ "include": "#html-attributes" }]
        },
        "4": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.style.html.fez" },
        "3": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "contentName": "source.css.scss",
      "patterns": [
        { "include": "source.css.scss" }
      ]
    },
    "info-block": {
      "begin": "^\\s*(<)(info)(\\b[^>]*)(>)",
      "end": "^\\s*(</)(info)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.info.fez" },
        "3": {
          "patterns": [{ "include": "#html-attributes" }]
        },
        "4": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.info.fez" },
        "3": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "contentName": "text.html.basic",
      "patterns": [
        { "include": "#template" }
      ]
    },
    "demo-block": {
      "begin": "^\\s*(<)(demo)(\\b[^>]*)(>)",
      "end": "^\\s*(</)(demo)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.demo.fez" },
        "3": {
          "patterns": [{ "include": "#html-attributes" }]
        },
        "4": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.demo.fez" },
        "3": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "contentName": "text.html.basic",
      "patterns": [
        { "include": "#template" }
      ]
    },
    "template": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#fez-block-start" },
        { "include": "#fez-block-middle" },
        { "include": "#fez-block-end" },
        { "include": "#fez-raw-html" },
        { "include": "#fez-json-debug" },
        { "include": "#fez-expression-legacy" },
        { "include": "#fez-expression" },
        { "include": "#html-tag-custom" },
        { "include": "#html-tag-void" },
        { "include": "#html-tag-close" },
        { "include": "#html-tag-open" },
        { "include": "text.html.basic" }
      ]
    },
    "fez-block-start": {
      "match": "(\\{)(#)(if|each|for|await|unless)\\b(.*?)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.block.begin.fez" },
        "2": { "name": "keyword.control.flow.fez" },
        "3": { "name": "keyword.control.flow.fez" },
        "4": {
          "patterns": [
            {
              "match": "\\b(as|in)\\b",
              "name": "keyword.operator.fez"
            },
            { "include": "source.js" }
          ]
        },
        "5": { "name": "punctuation.definition.block.end.fez" }
      }
    },
    "fez-block-middle": {
      "match": "(\\{)(:)(else if|else|then|catch)\\b(.*?)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.block.begin.fez" },
        "2": { "name": "keyword.control.flow.fez" },
        "3": { "name": "keyword.control.flow.fez" },
        "4": {
          "patterns": [{ "include": "source.js" }]
        },
        "5": { "name": "punctuation.definition.block.end.fez" }
      }
    },
    "fez-block-end": {
      "match": "(\\{)(/)(if|each|for|await|unless)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.block.begin.fez" },
        "2": { "name": "keyword.control.flow.fez" },
        "3": { "name": "keyword.control.flow.fez" },
        "4": { "name": "punctuation.definition.block.end.fez" }
      }
    },
    "fez-raw-html": {
      "match": "(\\{)(@html)\\s+(.*?)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.expression.begin.fez" },
        "2": { "name": "keyword.other.html.fez" },
        "3": {
          "patterns": [{ "include": "source.js" }]
        },
        "4": { "name": "punctuation.definition.expression.end.fez" }
      }
    },
    "fez-json-debug": {
      "match": "(\\{)(@json)\\s+(.*?)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.expression.begin.fez" },
        "2": { "name": "keyword.other.json.fez" },
        "3": {
          "patterns": [{ "include": "source.js" }]
        },
        "4": { "name": "punctuation.definition.expression.end.fez" }
      }
    },
    "fez-expression": {
      "begin": "\\{(?!\\{)(?![#/:])",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.expression.begin.fez" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.expression.end.fez" }
      },
      "contentName": "meta.embedded.expression.fez",
      "patterns": [
        { "include": "source.js" }
      ]
    },
    "fez-expression-legacy": {
      "begin": "\\{\\{(?![#/]|if |for |else|unless)",
      "end": "\\}\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.expression.begin.fez" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.expression.end.fez" }
      },
      "contentName": "meta.embedded.expression.fez",
      "patterns": [
        { "include": "source.js" }
      ]
    },
    "html-tag-custom": {
      "begin": "(<)([a-z][a-z0-9]*-[a-z0-9-]*)",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.custom.fez" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "patterns": [
        { "include": "#fez-attributes" },
        { "include": "#html-attributes" }
      ]
    },
    "html-tag-void": {
      "match": "(<)(area|base|br|col|embed|hr|img|input|keygen|link|menuitem|meta|param|source|track|wbr)\\b",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.html.fez" }
      }
    },
    "html-tag-open": {
      "begin": "(<)([a-zA-Z][a-zA-Z0-9]*)",
      "end": "(/?>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.html.fez" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "patterns": [
        { "include": "#fez-attributes" },
        { "include": "#html-attributes" }
      ]
    },
    "html-tag-close": {
      "match": "(</)([a-zA-Z][a-zA-Z0-9-]*)(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.html.fez" },
        "3": { "name": "punctuation.definition.tag.end.html.fez" }
      }
    },
    "fez-attributes": {
      "patterns": [
        {
          "match": "(fez:(?:bind|this|keep|use))(=)(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.fez" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "string.quoted.double.html" }
          }
        },
        {
          "match": "(class):([a-zA-Z_-][a-zA-Z0-9_:-]*)(=)(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "entity.other.attribute-name.class-directive.fez" },
            "3": { "name": "punctuation.separator.key-value.html" },
            "4": {
              "name": "string.quoted.double.html",
              "patterns": [{ "include": "#fez-expression" }]
            }
          }
        },
        {
          "match": "(class):([a-zA-Z_-][a-zA-Z0-9_:-]*)(=)(\\{[^}]*\\})",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "entity.other.attribute-name.class-directive.fez" },
            "3": { "name": "punctuation.separator.key-value.html" },
            "4": {
              "patterns": [{ "include": "#fez-expression" }]
            }
          }
        },
        {
          "match": "(?<![\\w-])(:)([a-zA-Z_][a-zA-Z0-9_]*)(=)(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.operator.evaluated.fez" },
            "2": { "name": "entity.other.attribute-name.evaluated.fez" },
            "3": { "name": "punctuation.separator.key-value.html" },
            "4": {
              "name": "string.quoted.double.html",
              "patterns": [{ "include": "source.js" }]
            }
          }
        },
        {
          "begin": "(?<![\\w-])(:)([a-zA-Z_][a-zA-Z0-9_]*)(=)(\\{)",
          "end": "(\\})",
          "beginCaptures": {
            "1": { "name": "keyword.operator.evaluated.fez" },
            "2": { "name": "entity.other.attribute-name.evaluated.fez" },
            "3": { "name": "punctuation.separator.key-value.html" },
            "4": { "name": "punctuation.definition.expression.begin.fez" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.expression.end.fez" }
          },
          "contentName": "meta.embedded.expression.fez",
          "patterns": [
            { "include": "source.js" }
          ]
        }
      ]
    },
    "html-attributes": {
      "patterns": [
        {
          "match": "\\b(on[a-z]+)(=)(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.event.html.fez" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": {
              "name": "string.quoted.double.html",
              "patterns": [
                {
                  "match": "fez\\.[a-zA-Z_][a-zA-Z0-9_]*",
                  "name": "entity.name.function.fez"
                }
              ]
            }
          }
        },
        {
          "begin": "([a-zA-Z_-][a-zA-Z0-9_:-]*)(=)(\\{)",
          "end": "(\\})",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "punctuation.definition.expression.begin.fez" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.expression.end.fez" }
          },
          "contentName": "meta.embedded.expression.fez",
          "patterns": [
            { "include": "source.js" }
          ]
        },
        {
          "match": "([a-zA-Z_-][a-zA-Z0-9_:-]*)(=)(\"[^\"]*\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": {
              "name": "string.quoted.double.html",
              "patterns": [{ "include": "#fez-expression" }]
            }
          }
        },
        {
          "match": "([a-zA-Z_-][a-zA-Z0-9_:-]*)(=)('[^']*')",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "string.quoted.single.html" }
          }
        },
        {
          "match": "\\b([a-zA-Z_-][a-zA-Z0-9_-]*)\\b(?!=)",
          "name": "entity.other.attribute-name.html"
        }
      ]
    },
    "script-ts-block": {
      "begin": "^\\s*(<)(script)(\\b[^>]*\\b(?:lang\\s*=\\s*[\\\"']?(?:ts|typescript)|type\\s*=\\s*[\\\"']?(?:ts|text/typescript))\\b[^>]*)(>)",
      "end": "^\\s*(</)(script)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.script.html.fez" },
        "3": {
          "patterns": [{ "include": "#html-attributes" }]
        },
        "4": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.script.html.fez" },
        "3": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "contentName": "source.ts",
      "patterns": [
        { "include": "#fez-class-block-ts" },
        { "include": "source.ts" }
      ]
    },
    "head-block": {
      "begin": "^\\s*(<)(head)(\\b[^>]*)(>)",
      "end": "^\\s*(</)(head)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.head.fez" },
        "3": {
          "patterns": [{ "include": "#html-attributes" }]
        },
        "4": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.head.fez" },
        "3": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "contentName": "text.html.basic",
      "patterns": [
        { "include": "text.html.basic" }
      ]
    },
    "fez-class-block-ts": {
      "begin": "^([ \\t]*)(class)\\s*(\\{)\\s*$",
      "end": "^\\1(\\})",
      "beginCaptures": {
        "2": { "name": "storage.type.class.fez" },
        "3": { "name": "punctuation.definition.block.js" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.js" }
      },
      "patterns": [
        { "include": "#fez-class-properties" },
        { "include": "source.ts" }
      ]
    },
    "slim-template": {
      "begin": "^(?=(?:[.#][a-zA-Z_!@*\\[(-]|(?:a|abbr|address|area|article|aside|audio|b|bdi|bdo|blockquote|br|button|canvas|caption|circle|cite|code|col|colgroup|data|datalist|dd|defs|del|details|dfn|dialog|div|dl|dt|ellipse|em|embed|fieldset|figcaption|figure|footer|form|g|h[1-6]|header|hgroup|hr|i|iframe|img|input|ins|kbd|label|legend|li|line|main|map|mark|menu|meter|nav|noscript|object|ol|optgroup|option|output|p|path|picture|polygon|polyline|pre|progress|q|rect|s|samp|section|select|slot|small|source|span|strong|sub|summary|sup|svg|table|tbody|td|template|textarea|tfoot|th|thead|time|tr|track|u|ul|use|var|video|wbr|[a-z][a-z0-9]*-[a-z0-9-]*)(?=[.#]|:\\s|=|\\s*$|\\s+[^\\s=]+=)|-\\s*(?:if|unless|each|for|await)\\s|-\\s*\\S.*\\.each(?:_with_index)?\\s+do\\s*\\||==?\\s))",
      "end": "(?=^<(?:script|style|head|info|demo|slim|xmp|template)\\b)",
      "contentName": "meta.embedded.block.slim.fez",
      "patterns": [{ "include": "#slim" }]
    },
    "slim-block": {
      "begin": "^\\s*(<)(slim)(\\b[^>]*)(>)",
      "end": "^\\s*(</)(slim)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.slim.fez" },
        "3": {
          "patterns": [{ "include": "#html-attributes" }]
        },
        "4": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html.fez" },
        "2": { "name": "entity.name.tag.slim.fez" },
        "3": { "name": "punctuation.definition.tag.end.html.fez" }
      },
      "contentName": "meta.embedded.block.slim.fez",
      "patterns": [
        { "include": "#slim" }
      ]
    },
    "slim": {
      "patterns": [
        { "include": "#slim-comment" },
        { "include": "#slim-ruby-each" },
        { "include": "#slim-control" },
        { "include": "#slim-output" },
        { "include": "#slim-text" },
        { "include": "#slim-raw-html" },
        { "include": "#slim-expression-line" },
        { "include": "#slim-tag" }
      ]
    },
    "slim-comment": {
      "begin": "^([ \\t]*)(/)",
      "end": "^(?!\\1[ \\t]+\\S|[ \\t]*$)",
      "name": "comment.block.slim.fez",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.comment.slim.fez" }
      }
    },
    "slim-ruby-each": {
      "match": "^[ \\t]*(-)\\s*(.+?)(\\.)(each|each_with_index)\\s+(do)\\s*(\\|)([^|]*)(\\|)\\s*$",
      "captures": {
        "1": { "name": "keyword.control.flow.slim.fez" },
        "2": {
          "patterns": [{ "include": "source.js" }]
        },
        "4": { "name": "keyword.control.flow.slim.fez" },
        "5": { "name": "keyword.control.flow.slim.fez" },
        "6": { "name": "punctuation.definition.parameters.slim.fez" },
        "7": { "name": "variable.parameter.slim.fez" },
        "8": { "name": "punctuation.definition.parameters.slim.fez" }
      }
    },
    "slim-control": {
      "begin": "^[ \\t]*(-)\\s*(else if|elsif|if|else|unless|each|for|await|then|catch)\\b",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "keyword.control.flow.slim.fez" },
        "2": { "name": "keyword.control.flow.slim.fez" }
      },
      "patterns": [
        {
          "match": "\\b(as|in)\\b",
          "name": "keyword.operator.fez"
        },
        { "include": "source.js" }
      ]
    },
    "slim-output": {
      "begin": "^[ \\t]*(==?)",
      "end": "$",
      "beginCaptures": {
        "1": { "name": "keyword.operator.output.slim.fez" }
      },
      "patterns": [
        { "include": "source.js" }
      ],
      "contentName": "meta.embedded.expression.fez"
    },
    "slim-inline-text": {
      "patterns": [
        {
          "begin": "#\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.expression.begin.fez" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.expression.end.fez" }
          },
          "contentName": "meta.embedded.expression.fez",
          "patterns": [
            { "include": "source.js" }
          ]
        },
        { "include": "#fez-expression" }
