{
  "name": "@dinoreic/fez",
  "version": "0.7.0",
  "description": "Runtime custom DOM elements lib",
  "main": "dist/fez.js",
  "type": "module",
  "types": "fez.d.ts",
  "exports": {
    ".": {
      "types": "./fez.d.ts",
      "import": "./dist/fez.esm.js",
      "default": "./dist/fez.js"
    },
    "./plugin": "./src/fez/plugin.js",
    "./log": "./src/log.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fez": "bin/fez"
  },
  "engines": {
    "bun": ">=1.3.8"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "fez.d.ts",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dom",
    "elements",
    "custom-elements",
    "web-components",
    "frontend"
  ],
  "author": "Dino Reic",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dux/fez.git"
  },
  "bugs": {
    "url": "https://github.com/dux/fez/issues"
  },
  "homepage": "https://github.com/dux/fez#readme",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "0.23.0",
    "eslint": "^8.57.0",
    "glob-cli": "^1.0.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "mime": "^4.0.7"
  },
  "scripts": {
    "build": "bun build.js b",
    "b": "bun run build",
    "watch": "bun build.js w",
    "server": "bun run lib/server.js",
    "dev": "bunx concurrently --kill-others \"bun run server\" \"find src docs_src lib | entr -cn sh -c 'bun run index && bun run b && bun run static'\"",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test": "bun test test/*.test.js && bun test/browser/run.js",
    "test:browser": "bun test/browser/run.js",
    "test:coverage": "bun test --coverage",
    "prepublishOnly": "bun run build && bun run test",
    "release": "bun publish --access public",
    "refactor": "bun bin/fez-refactor",
    "index": "ls docs_src/root/fez/*.fez | xargs -n1 basename | sed 's/\\.fez$//' | sort | sed 's/^/fez\\//' > docs_src/root/fez.txt",
    "static": "bun bin/fez-static build",
    "vscode:lint": "node --check vscode/src/extension.js",
    "vscode:test": "node --check vscode/src/extension.js",
    "vscode:package": "cd vscode && bunx @vscode/vsce package --no-dependencies",
    "vscode:install": "cd vscode && bunx @vscode/vsce package --allow-missing-repository --no-dependencies && code --install-extension fez-vscode-tools-0.1.0.vsix"
  },
  "dependencies": {
    "glob": "^13.0.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.1"
  },
  "peerDependencies": {
    "esbuild": ">=0.18"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  }
}
