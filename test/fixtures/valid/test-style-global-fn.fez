<style>
  padding: 10px;

  .card { color: red; }

  :global(.third-party-widget) {
    position: fixed;

    .inner { color: blue; }
  }

  :global(.one-liner) { margin: 0; }

  /* at-rules that cannot nest must be lifted out of the :fez wrapper */
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @font-face {
    font-family: probe;
    src: url(probe.woff2);
  }

  /* whole at-rule on one line must hoist too */
  @keyframes spin-one-line { to { transform: rotate(360deg); } }

  /* @media nests fine and stays scoped */
  @media (max-width: 500px) {
    .card { color: green; }
  }
</style>

<button>hi</button>
