#!/usr/bin/env bun

import { parseArgs } from 'util';
import fs from 'fs';
import path from 'path';
import { globSync } from 'glob';
import prettier from 'prettier';
import createTemplate, { clearTemplateCache } from '../src/fez/lib/template.js';
import { extractFezDefinitions, parseFezSource } from '../src/fez/lib/source-parser.js';
import { captureConsoleErrors, debugTemplateFunction, firstLine } from './template-cli.js';
import { locateSlimError, slimToFez } from '../src/fez/lib/slim.js';
import { stripNodeWhitespace } from '../src/fez/lib/template-compiler-lib.js';
import { stripTypeScript } from '../src/fez/lib/strip-types.js';
import { splitScript, styleScopeErrors } from '../src/fez/lib/validate.js';
import { buildClassSource } from '../src/fez/lib/class-source.js';

const INFO = 'Compile Fez components and report errors';

let values, positionals;
try {
  ({ values, positionals } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      help: { type: 'boolean', short: 'h' },
      output: { type: 'boolean', short: 'o' },
      'debug-template': { type: 'boolean', short: 'd' },
      'dump-template': { type: 'boolean', short: 't' },
      json: { type: 'boolean' },
      info: { type: 'boolean' },
    },
    allowPositionals: true,
  }));
} catch (error) {
  console.error(`fez compile: ${firstLine(error.message)}. See 'fez compile --help'.`);
  process.exit(1);
}

if (values.info) {
  console.log(INFO);
  process.exit(0);
}

if (values.help || positionals.length === 0) {
  console.log(`Usage: fez compile <file-or-glob> [file2.fez ...]

${INFO}

Options:
  -h, --help            Show this help message
  -o, --output          Output compiled JavaScript
  -d, --debug-template  Print generated template function body on template errors
  -t, --dump-template   Print the final Fez template of each component
                        (<slim> templates one node per line with source line numbers)
      --json            Print errors as a JSON array (for editors)

Examples:
  fez compile docs/fez/ui-counter.fez
  fez compile 'docs/fez/*.fez'
  fez compile -o docs/fez/ui-counter.fez > compiled.js
  fez compile --debug-template docs/fez/ui-counter.fez
  fez compile -t docs/fez/ui-counter.fez
  fez compile --json docs/fez/ui-counter.fez
`);
  process.exit(0);
}

const input = expandInputs(positionals);
if (input.errors.length) {
  reportErrors(input.errors);
  process.exit(1);
}

const results = [];
for (const filePath of input.files) {
  results.push(
    await compileFile(filePath, {
      debugTemplate: values['debug-template'],
      dumpTemplate: values['dump-template'],
    }),
  );
}

if (values['dump-template']) {
  process.stdout.write(results.flatMap((result) => result.dumps).join('\n\n') + '\n');
}

const errors = results.flatMap((result) => result.errors);
if (errors.length) {
  reportErrors(errors);
  process.exit(1);
}

if (values.json) {
  console.log('[]');
} else if (values['dump-template']) {
  // the dump is the output
} else if (values.output) {
  process.stdout.write(results.flatMap((result) => result.compiled).join('\n'));
} else {
  for (const result of results) {
    const detail = result.components === 1 ? '' : ` (${result.components} components)`;
    console.log(`${result.file}: compiled without errors${detail}`);
  }
}

function expandInputs(inputs) {
  const files = [];
  const errors = [];

  for (const input of inputs) {
    if (/[*?\[\]{}]/.test(input)) {
      const matches = globSync(input, { nodir: true }).filter(
        (file) => !path.basename(file).includes('.tmp.'),
      );
      if (!matches.length) {
        errors.push({ file: input, kind: 'File', message: 'No files matched' });
      } else {
        files.push(...matches);
      }
    } else {
      files.push(input);
    }
  }

  return { files: [...new Set(files)], errors };
}

function readSource(filePath) {
  const absolutePath = path.resolve(filePath);
  try {
    const stat = fs.statSync(absolutePath);
    if (!stat.isFile()) {
      throw new Error('Not a file');
    }
    return { content: fs.readFileSync(absolutePath, 'utf-8') };
  } catch (error) {
    const message =
      error.code === 'ENOENT' ? `File not found: ${filePath}` : firstLine(error.message);
    return { error: { file: filePath, kind: 'File', message } };
  }
}

async function compileFile(filePath, options = {}) {
  const source = readSource(filePath);
  if (source.error) {
    return { file: filePath, errors: [source.error], compiled: [], dumps: [], components: 0 };
  }

  const extracted = extractFezDefinitions(source.content);
  const errors = extracted.errors.map((error) => ({ ...error, file: filePath }));
  const units = extracted.definitions.map((definition) => ({
    name: definition.name,
    source: definition.source,
    lineOffset: definition.contentLine - 1,
  }));
  if (!units.length) {
    units.push({
      name: path.basename(filePath, '.fez'),
      source: source.content,
      lineOffset: 0,
    });
  }

  const compiled = [];
  const dumps = [];
  for (const unit of units) {
    const result = await compileUnit(filePath, unit, options);
    errors.push(...result.errors);
    if (result.compiled) {
      compiled.push(result.compiled);
    }
    if (options.dumpTemplate) {
      dumps.push(dumpTemplate(filePath, unit));
    }
  }

  return { file: filePath, errors, compiled, dumps, components: units.length };
}

async function compileUnit(filePath, unit, options) {
  const errors = [];
  const componentName = unit.name;
  if (!componentName.includes('-')) {
    errors.push({
      message: `Invalid component name "${componentName}". Custom element names must contain a dash (e.g., 'my-element', 'ui-button').`,
      file: filePath,
      kind: 'Naming',
      line: unit.lineOffset + 1,
    });
  }

  const parsed = parseFezSource(unit.source);
  errors.push(
    ...parsed.errors.map((error) => ({
      ...error,
      file: filePath,
      line: error.line + unit.lineOffset,
    })),
  );

  if (parsed.scriptLang === 'ts') {
    const scriptBlock = parsed.blocks.find((block) => block.type === 'script');
    try {
      parsed.script = stripTypeScript(parsed.script);
    } catch (error) {
      const location = error.location;
      errors.push({
        message: error.message,
        file: filePath,
        kind: 'Script',
        line:
          (scriptBlock?.contentLine || 1) + unit.lineOffset + (location?.line ?? 1) - 1,
        column: location?.column,
      });
      return { errors, compiled: null };
    }
  }

  const script = parsed.blocks.find((block) => block.type === 'script');
  errors.push(
    ...validateScript(parsed.script, filePath, (script?.contentLine || 1) + unit.lineOffset),
  );

  for (const block of parsed.blocks.filter(
    (item) => item.type === 'style' || item.type === 'styleGlobal',
  )) {
    errors.push(
      ...validateStyle(
        block.content,
        filePath,
        block.type === 'styleGlobal',
        block.contentLine - 1 + unit.lineOffset,
      ),
    );
  }

  errors.push(...validateLegacyTemplate(parsed.html, filePath));
  errors.push(
    ...validateTemplateCompiler(parsed, filePath, componentName, options.debugTemplate).map(
      (error) => (error.line ? { ...error, line: error.line + unit.lineOffset } : error),
    ),
  );

  if (errors.length) {
    return { errors, compiled: null };
  }

  const formatted = await formatCompiledJS(generateCompiledJS(parsed, componentName), filePath);
  if (formatted.error) {
    return { errors: [formatted.error], compiled: null };
  }
  return { errors, compiled: formatted.code };
}

function validateScript(script, filePath, sourceLine) {
  const errors = [];
  if (!script.trim()) {
    return errors;
  }

  const hasImports = /^\s*import\s+/m.test(script);
  const { preamble, body, hasClass } = splitScript(script);

  if (hasClass) {
    const classBody = `class {\n${body}`;

    if (preamble.trim()) {
      const withoutImports = preamble.replace(/^\s*import\s+.*$/gm, '// import removed');
      if (withoutImports.trim()) {
        try {
          new Function(withoutImports);
        } catch (error) {
          if (!hasImports || !error.message.includes('import')) {
            errors.push(scriptError(error, filePath, sourceLine));
          }
        }
      }
    }

    if (classBody.trim()) {
      try {
        new Function(`(${classBody})`);
      } catch (error) {
        const preambleLines = preamble.split('\n').length;
        errors.push(scriptError(error, filePath, sourceLine + preambleLines - 1));
      }
    }
  } else {
    try {
      new Function(`(class {\n${script}\n})`);
    } catch (error) {
      errors.push(scriptError(error, filePath, sourceLine - 1));
    }
  }

  return errors;
}

function scriptError(error, filePath, lineOffset) {
  const lineMatch = error.stack?.match(/<anonymous>:(\d+):(\d+)/);
  const result = { message: error.message, file: filePath, kind: 'JavaScript' };
  if (lineMatch) {
    result.line = Math.max(1, Number(lineMatch[1]) + lineOffset - 1);
    result.column = Number(lineMatch[2]);
  }
  return result;
}

function validateStyleScope(rawStyle, filePath, isGlobal, lineOffset) {
  return styleScopeErrors(rawStyle, isGlobal).map(({ message, index }) => ({
    message,
    file: filePath,
    kind: 'Style',
    line: lineOffset + rawStyle.slice(0, index).split('\n').length,
  }));
}

function validateStyle(style, filePath, isGlobal = false, lineOffset = 0) {
  const errors = [];
  if (!style || !style.trim()) {
    return errors;
  }
  errors.push(...validateStyleScope(style, filePath, isGlobal, lineOffset));

  let braces = 0;
  let parens = 0;
  let inString = null;
  let stringStart = null;
  let line = 1;
  let column = 0;

  for (let index = 0; index < style.length; index++) {
    const character = style[index];
    if (character === '\n') {
      line++;
      column = 0;
      continue;
    }
    column++;

    if (inString) {
      if (character === '\\') {
        index++;
        column++;
        continue;
      }
      if (character === inString) {
        inString = null;
        stringStart = null;
      }
      continue;
    }

    if (character === '/' && style[index + 1] === '*') {
      const startLine = line;
      const startColumn = column;
      index += 2;
      column += 2;
      while (index < style.length && !(style[index] === '*' && style[index + 1] === '/')) {
        if (style[index] === '\n') {
          line++;
          column = 0;
        } else {
          column++;
        }
        index++;
      }
      if (index >= style.length) {
        errors.push({
          message: `Unterminated /* */ comment starting at style block line ${startLine}:${startColumn}`,
          file: filePath,
          line: lineOffset + startLine,
          column: startColumn,
          kind: 'Style',
        });
        return errors;
      }
      index++;
      column++;
      continue;
    }

    if (character === '"' || character === "'") {
      inString = character;
      stringStart = { line, column };
      continue;
    }
    if (character === '{') {
      braces++;
    } else if (character === '}') {
      braces--;
      if (braces < 0) {
        errors.push({
          message: 'Unmatched }',
          file: filePath,
          line: lineOffset + line,
          column,
          kind: 'Style',
        });
        return errors;
      }
    } else if (character === '(') {
      parens++;
    } else if (character === ')') {
      parens--;
      if (parens < 0) {
        errors.push({
          message: 'Unmatched )',
          file: filePath,
          line: lineOffset + line,
          column,
          kind: 'Style',
        });
        return errors;
      }
    }
  }

  if (inString) {
    errors.push({
      message: `Unterminated ${inString} string starting at style block line ${stringStart.line}:${stringStart.column}`,
      file: filePath,
      line: lineOffset + stringStart.line,
      column: stringStart.column,
      kind: 'Style',
    });
  }
  if (braces > 0) {
    errors.push({
      message: `${braces} unclosed { brace${braces > 1 ? 's' : ''} in style block`,
      file: filePath,
      line: lineOffset + line,
      kind: 'Style',
    });
  }
  if (parens > 0) {
    errors.push({
      message: `${parens} unclosed ( paren${parens > 1 ? 's' : ''} in style block`,
      file: filePath,
      line: lineOffset + line,
      kind: 'Style',
    });
  }
  return errors;
}

function validateLegacyTemplate(html, filePath) {
  const errors = [];
  const ifOpens = (html.match(/\{\{#?if\s/g) || []).length;
  const ifCloses = (html.match(/\{\{\/?#?if\}\}/g) || []).length;
  if (ifOpens !== ifCloses) {
    errors.push({
      message: `Unmatched {{if}} blocks: ${ifOpens} opens, ${ifCloses} closes`,
      file: filePath,
      kind: 'Template',
    });
  }

  const forOpens = (html.match(/\{\{for\s/g) || []).length;
  const forCloses = (html.match(/\{\{\/for\}\}/g) || []).length;
  if (forOpens !== forCloses) {
    errors.push({
      message: `Unmatched {{for}} blocks: ${forOpens} opens, ${forCloses} closes`,
      file: filePath,
      kind: 'Template',
    });
  }

  if (/\w+=["'][^"']*\{\{#?if\s/.test(html)) {
    errors.push({
      message: '{{if}} block found inside attribute - use ternary operator instead',
      file: filePath,
      kind: 'Template',
    });
  }
  return errors;
}

function validateTemplateCompiler(parsed, filePath, componentName, debugTemplate = false) {
  const html = parsed.html;
  if (!html.trim()) {
    return [];
  }
  const logs = captureConsoleErrors(() => {
    clearTemplateCache();
    createTemplate(html, { name: componentName });
    clearTemplateCache();
  });

  const errors = [];
  for (let index = 0; index < logs.length; index++) {
    const match = logs[index].match(/^FEZ template compile error in <([^>]+)>:\s*(.*)$/);
    if (!match) {
      continue;
    }
    const line =
      parsed.template.lang === 'slim' ? locateSlimError(html, parsed.template.map) : null;
    errors.push({
      message: match[2] || 'Template compiler failed',
      file: filePath,
      kind: 'Template compiler',
      ...(line ? { line } : {}),
      detail: (logs[index + 1] || '').replace(/^Template:\s*/, ''),
      debug: debugTemplate ? debugTemplateFunction(html, componentName) : '',
    });
  }
  return errors;
}

function dumpTemplate(filePath, unit) {
  const parsed = parseFezSource(unit.source);
  const { template } = parsed;
  if (template.lang !== 'slim') {
    return `== <${unit.name}> ${filePath} ==\n${stripNodeWhitespace(parsed.html).trim()}`;
  }
  const lineOffset = template.contentLine - 1 + unit.lineOffset;
  const body = slimToFez(template.content, { pretty: true, lineOffset }).html;
  return `== <${unit.name}> ${filePath}:${template.line + unit.lineOffset} ==\n${body}`;
}

function reportErrors(errors) {
  if (values.json) {
    const fields = ['file', 'line', 'column', 'kind', 'message', 'detail'];
    const rows = errors.map((error) =>
      Object.fromEntries(fields.filter((key) => error[key] != null).map((key) => [key, error[key]])),
    );
    console.log(JSON.stringify(rows, null, 2));
  } else {
    errors.forEach(printError);
  }
}

function generateCompiledJS(parsed, componentName) {
  const klass = buildClassSource(parsed);

  const { preamble, body } = splitScript(klass);
  const classBody = `class {\n${body}`;
  return `${preamble.trim() ? preamble.trim() + '\n\n' : ''}Fez('${componentName}', ${classBody})`;
}

async function formatCompiledJS(code, filePath) {
  try {
    return { code: await prettier.format(code, { parser: 'babel' }) };
  } catch (error) {
    return { error: { message: firstLine(error.message), file: filePath, kind: 'Format' } };
  }
}

function printError(error) {
  const location = error.line ? `:${error.line}${error.column ? ':' + error.column : ''}` : '';
  const kind = error.kind ? `${error.kind} error: ` : '';
  console.error(`${error.file}${location}: ${kind}${error.message}`);
  if (error.detail) {
    console.error(`  Template: ${error.detail}`);
  }
  if (error.debug) {
    console.error(`\n${error.debug}`);
  }
}
