#!/usr/bin/env bun

import { parseArgs } from 'util';
import fs from 'fs';
import path from 'path';
import { globSync } from 'glob';
import prettier from 'prettier';
import createTemplate, { clearTemplateCache } from '../src/fez/lib/template.js';
import { extractFezDefinitions, parseFezSource } from '../src/fez/lib/source-parser.js';

const INFO = 'Compile Fez components and report errors';

let values, positionals;
try {
  ({ values, positionals } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      help: { type: 'boolean', short: 'h' },
      output: { type: 'boolean', short: 'o' },
      'debug-template': { type: 'boolean', short: 'd' },
      info: { type: 'boolean' },
    },
    allowPositionals: true,
  }));
} catch (error) {
  console.error(`fez compile: ${firstLine(error.message)}. See 'fez compile --help'.`);
  process.exit(1);
}

if (values.info) {
  console.log(INFO);
  process.exit(0);
}

if (values.help || positionals.length === 0) {
  console.log(`Usage: fez compile <file-or-glob> [file2.fez ...]

${INFO}

Options:
  -h, --help            Show this help message
  -o, --output          Output compiled JavaScript
  -d, --debug-template  Print generated template function body on template errors

Examples:
  fez compile docs/fez/ui-counter.fez
  fez compile 'docs/fez/*.fez'
  fez compile -o docs/fez/ui-counter.fez > compiled.js
  fez compile --debug-template docs/fez/ui-counter.fez
`);
  process.exit(0);
}

const input = expandInputs(positionals);
if (input.errors.length) {
  input.errors.forEach((error) => printError(error));
  process.exit(1);
}

const results = [];
for (const filePath of input.files) {
  results.push(
    await compileFile(filePath, {
      debugTemplate: values['debug-template'],
    }),
  );
}

const errors = results.flatMap((result) => result.errors);
if (errors.length) {
  errors.forEach(printError);
  process.exit(1);
}

if (values.output) {
  process.stdout.write(results.flatMap((result) => result.compiled).join('\n'));
} else {
  for (const result of results) {
    const detail = result.components === 1 ? '' : ` (${result.components} components)`;
    console.log(`${result.file}: compiled without errors${detail}`);
  }
}

function firstLine(message) {
  return String(message || 'Unknown error').split('\n')[0];
}

function expandInputs(inputs) {
  const files = [];
  const errors = [];

  for (const input of inputs) {
    if (/[*?\[\]{}]/.test(input)) {
      const matches = globSync(input, { nodir: true }).filter(
        (file) => !path.basename(file).includes('.tmp.'),
      );
      if (!matches.length) {
        errors.push({ file: input, kind: 'File', message: 'No files matched' });
      } else {
        files.push(...matches);
      }
    } else {
      files.push(input);
    }
  }

  return { files: [...new Set(files)], errors };
}

function readSource(filePath) {
  const absolutePath = path.resolve(filePath);
  try {
    const stat = fs.statSync(absolutePath);
    if (!stat.isFile()) {
      throw new Error('Not a file');
    }
    return { content: fs.readFileSync(absolutePath, 'utf-8') };
  } catch (error) {
    const message =
      error.code === 'ENOENT' ? `File not found: ${filePath}` : firstLine(error.message);
    return { error: { file: filePath, kind: 'File', message } };
  }
}

async function compileFile(filePath, options = {}) {
  const source = readSource(filePath);
  if (source.error) {
    return { file: filePath, errors: [source.error], compiled: [], components: 0 };
  }

  const extracted = extractFezDefinitions(source.content);
  const errors = extracted.errors.map((error) => ({ ...error, file: filePath }));
  const units = extracted.definitions.map((definition) => ({
    name: definition.name,
    source: definition.source,
    lineOffset: definition.contentLine - 1,
  }));
  if (!units.length) {
    units.push({
      name: path.basename(filePath, '.fez'),
      source: source.content,
      lineOffset: 0,
    });
  }

  const compiled = [];
  for (const unit of units) {
    const result = await compileUnit(filePath, unit, options);
    errors.push(...result.errors);
    if (result.compiled) {
      compiled.push(result.compiled);
    }
  }

  return { file: filePath, errors, compiled, components: units.length };
}

async function compileUnit(filePath, unit, options) {
  const errors = [];
  const componentName = unit.name;
  if (!componentName.includes('-')) {
    errors.push({
      message: `Invalid component name "${componentName}". Custom element names must contain a dash (e.g., 'my-element', 'ui-button').`,
      file: filePath,
      kind: 'Naming',
      line: unit.lineOffset + 1,
    });
  }

  const parsed = parseFezSource(unit.source);
  errors.push(
    ...parsed.errors.map((error) => ({
      ...error,
      file: filePath,
      line: error.line + unit.lineOffset,
    })),
  );

  const script = parsed.blocks.find((block) => block.type === 'script');
  errors.push(
    ...validateScript(parsed.script, filePath, (script?.contentLine || 1) + unit.lineOffset),
  );

  errors.push(...validateRemovedApi(parsed, unit.source, filePath, unit.lineOffset));

  for (const block of parsed.blocks.filter(
    (item) => item.type === 'style' || item.type === 'styleGlobal',
  )) {
    errors.push(
      ...validateStyle(
        block.content,
        filePath,
        block.type === 'styleGlobal',
        block.contentLine - 1 + unit.lineOffset,
      ),
    );
  }

  errors.push(...validateLegacyTemplate(parsed.html, filePath));
  errors.push(
    ...validateTemplateCompiler(parsed.html, filePath, componentName, options.debugTemplate),
  );

  if (errors.length) {
    return { errors, compiled: null };
  }

  const formatted = await formatCompiledJS(generateCompiledJS(parsed, componentName), filePath);
  if (formatted.error) {
    return { errors: [formatted.error], compiled: null };
  }
  return { errors, compiled: formatted.code };
}

function validateScript(script, filePath, sourceLine) {
  const errors = [];
  if (!script.trim()) {
    return errors;
  }

  const hasImports = /^\s*import\s+/m.test(script);
  const hasExplicitClass = /class\s+\{/.test(script);

  if (hasExplicitClass) {
    const parts = script.split(/class\s+\{/, 2);
    const preamble = parts[0] || '';
    const classBody = parts[1] ? `class {\n${parts[1]}` : '';

    if (preamble.trim()) {
      const withoutImports = preamble.replace(/^\s*import\s+.*$/gm, '// import removed');
      if (withoutImports.trim()) {
        try {
          new Function(withoutImports);
        } catch (error) {
          if (!hasImports || !error.message.includes('import')) {
            errors.push(scriptError(error, filePath, sourceLine));
          }
        }
      }
    }

    if (classBody.trim()) {
      try {
        new Function(`(${classBody})`);
      } catch (error) {
        const preambleLines = preamble.split('\n').length;
        errors.push(scriptError(error, filePath, sourceLine + preambleLines - 1));
      }
    }
  } else {
    try {
      new Function(`(class {\n${script}\n})`);
    } catch (error) {
      errors.push(scriptError(error, filePath, sourceLine - 1));
    }
  }

  return errors;
}

function scriptError(error, filePath, lineOffset) {
  const lineMatch = error.stack?.match(/<anonymous>:(\d+):(\d+)/);
  const result = { message: error.message, file: filePath, kind: 'JavaScript' };
  if (lineMatch) {
    result.line = Math.max(1, Number(lineMatch[1]) + lineOffset - 1);
    result.column = Number(lineMatch[2]);
  }
  return result;
}

function withoutComments(style) {
  return style
    .replace(/\/\*[\s\S]*?\*\//g, (match) => match.replace(/[^\n]/g, ' '))
    .replace(
      /^([ \t]*)\/\/[^\n]*/gm,
      (match, indent) => indent + ' '.repeat(match.length - indent.length),
    );
}

// Blank out <demo> and <info> bodies while keeping line numbers, so documented
// examples of the old API are never reported as real usage.
function withoutDocBlocks(source) {
  return source.replace(/(<(demo|info)\b[^>]*>)([\s\S]*?)(<\/\2>)/gi, (all, open, tag, body, close) =>
    open + body.replace(/[^\n]/g, ' ') + close,
  );
}

/**
 * APIs removed by the 0.6.x state consolidation. These fail at runtime, not at
 * compile time - `this.local` throws, a stale fez:this ref reads undefined and
 * silently no-ops behind optional chaining - so the CLI is the only place that
 * can catch them before a page is loaded.
 *
 * Deliberately not mirrored into src/fez/compile.js: a throw there aborts
 * registration and leaves the raw custom tag visible on the page. A migration
 * aid should not take the page down.
 */
function validateRemovedApi(parsed, rawSource, filePath, lineOffset) {
  const errors = [];
  const source = withoutComments(withoutDocBlocks(rawSource));
  const add = (regex, message) => {
    const index = source.search(regex);
    if (index < 0) {
      return false;
    }
    errors.push({
      message,
      file: filePath,
      kind: 'API',
      line: lineOffset + source.slice(0, index).split('\n').length,
    });
    return true;
  };

  // `const me = this` is common in older components, and a ref or a .local read
  // through the alias breaks exactly the same way - so the alias counts as `this`.
  const instance = ['this', 'fez'];
  for (const match of source.matchAll(/\b(?:var|const|let)\s+([A-Za-z_$][\w$]*)\s*=\s*this\b/g)) {
    instance.push(match[1]);
  }
  const onInstance = (property) => new RegExp(`\\b(?:${instance.join('|')})\\.${property}\\b`);

  add(
    onInstance('local'),
    'this.local was removed. Move per-instance data to this.state - a write to a key the template never reads schedules no render.',
  );

  add(/\bFez\.css\(/, 'Fez.css() was removed. Use Fez.cssClass().');

  // fez:this="name" now lands on this.state.name (src/fez/instance.js, fetchAttr
  // writes this._stateRaw). Reading it off the instance yields undefined.
  const refs = new Set(
    [...parsed.html.matchAll(/fez[:-]this="([A-Za-z_$][\w$]*)"/g)].map((match) => match[1]),
  );
  for (const ref of refs) {
    // A file that assigns the ref itself (this.el = this.find('input')) still
    // works - the assignment wins. That is redundancy, which `fez refactor` reports.
    if (new RegExp(`\\bthis\\.${ref}\\s*=[^=]`).test(source)) {
      continue;
    }
    add(
      onInstance(ref),
      `fez:this="${ref}" lands on this.state.${ref}. Read it as this.state.${ref} (fez.state.${ref} in template handlers).`,
    );
  }

  return errors;
}

function validateStyleScope(rawStyle, filePath, isGlobal, lineOffset) {
  const errors = [];
  const style = withoutComments(rawStyle);
  const add = (regex, message) => {
    const index = style.search(regex);
    if (index < 0) {
      return;
    }
    errors.push({
      message,
      file: filePath,
      kind: 'Style',
      line: lineOffset + style.slice(0, index).split('\n').length,
    });
  };

  if (!isGlobal) {
    add(/(?:^|\s)body\s*\{/, 'body { } in a scoped <style>. Move these rules to <style global>.');
  } else {
    add(
      /:global\(/,
      ':global() inside <style global>. These rules are already global - drop the wrapper.',
    );
  }
  add(/:host\b/, ':host is not supported. <style> is already scoped - use `&` for the root node.');
  add(
    /:fez\b/,
    ':fez is no longer an author-facing selector. <style> is already scoped - use `&` for the root node.',
  );
  return errors;
}

function validateStyle(style, filePath, isGlobal = false, lineOffset = 0) {
  const errors = [];
  if (!style || !style.trim()) {
    return errors;
  }
  errors.push(...validateStyleScope(style, filePath, isGlobal, lineOffset));

  let braces = 0;
  let parens = 0;
  let inString = null;
  let stringStart = null;
  let line = 1;
  let column = 0;

  for (let index = 0; index < style.length; index++) {
    const character = style[index];
    if (character === '\n') {
      line++;
      column = 0;
      continue;
    }
    column++;

    if (inString) {
      if (character === '\\') {
        index++;
        column++;
        continue;
      }
      if (character === inString) {
        inString = null;
        stringStart = null;
      }
      continue;
    }

    if (character === '/' && style[index + 1] === '*') {
      const startLine = line;
      const startColumn = column;
      index += 2;
      column += 2;
      while (index < style.length && !(style[index] === '*' && style[index + 1] === '/')) {
        if (style[index] === '\n') {
          line++;
          column = 0;
        } else {
          column++;
        }
        index++;
      }
      if (index >= style.length) {
        errors.push({
          message: `Unterminated /* */ comment starting at style block line ${startLine}:${startColumn}`,
          file: filePath,
          line: lineOffset + startLine,
          column: startColumn,
          kind: 'Style',
        });
        return errors;
      }
      index++;
      column++;
      continue;
    }

    if (character === '"' || character === "'") {
      inString = character;
      stringStart = { line, column };
      continue;
    }
    if (character === '{') {
      braces++;
    } else if (character === '}') {
      braces--;
      if (braces < 0) {
        errors.push({
          message: 'Unmatched }',
          file: filePath,
          line: lineOffset + line,
          column,
          kind: 'Style',
        });
        return errors;
      }
    } else if (character === '(') {
      parens++;
    } else if (character === ')') {
      parens--;
      if (parens < 0) {
        errors.push({
          message: 'Unmatched )',
          file: filePath,
          line: lineOffset + line,
          column,
          kind: 'Style',
        });
        return errors;
      }
    }
  }

  if (inString) {
    errors.push({
      message: `Unterminated ${inString} string starting at style block line ${stringStart.line}:${stringStart.column}`,
      file: filePath,
      line: lineOffset + stringStart.line,
      column: stringStart.column,
      kind: 'Style',
    });
  }
  if (braces > 0) {
    errors.push({
      message: `${braces} unclosed { brace${braces > 1 ? 's' : ''} in style block`,
      file: filePath,
      line: lineOffset + line,
      kind: 'Style',
    });
  }
  if (parens > 0) {
    errors.push({
      message: `${parens} unclosed ( paren${parens > 1 ? 's' : ''} in style block`,
      file: filePath,
      line: lineOffset + line,
      kind: 'Style',
    });
  }
  return errors;
}

function validateLegacyTemplate(html, filePath) {
  const errors = [];
  const ifOpens = (html.match(/\{\{#?if\s/g) || []).length;
  const ifCloses = (html.match(/\{\{\/?#?if\}\}/g) || []).length;
  if (ifOpens !== ifCloses) {
    errors.push({
      message: `Unmatched {{if}} blocks: ${ifOpens} opens, ${ifCloses} closes`,
      file: filePath,
      kind: 'Template',
    });
  }

  const forOpens = (html.match(/\{\{for\s/g) || []).length;
  const forCloses = (html.match(/\{\{\/for\}\}/g) || []).length;
  if (forOpens !== forCloses) {
    errors.push({
      message: `Unmatched {{for}} blocks: ${forOpens} opens, ${forCloses} closes`,
      file: filePath,
      kind: 'Template',
    });
  }

  if (/\w+=["'][^"']*\{\{#?if\s/.test(html)) {
    errors.push({
      message: '{{if}} block found inside attribute - use ternary operator instead',
      file: filePath,
      kind: 'Template',
    });
  }
  return errors;
}

function validateTemplateCompiler(html, filePath, componentName, debugTemplate = false) {
  if (!html.trim()) {
    return [];
  }
  const logs = captureConsoleErrors(() => {
    clearTemplateCache();
    createTemplate(html, { name: componentName });
    clearTemplateCache();
  });

  const errors = [];
  for (let index = 0; index < logs.length; index++) {
    const match = logs[index].match(/^FEZ template compile error in <([^>]+)>:\s*(.*)$/);
    if (!match) {
      continue;
    }
    errors.push({
      message: match[2] || 'Template compiler failed',
      file: filePath,
      kind: 'Template compiler',
      detail: (logs[index + 1] || '').replace(/^Template:\s*/, ''),
      debug: debugTemplate ? debugTemplateFunction(html, componentName) : '',
    });
  }
  return errors;
}

function captureConsoleErrors(callback) {
  const oldError = console.error;
  const logs = [];
  console.error = (...args) => logs.push(args.map(String).join(' '));
  try {
    callback();
  } finally {
    clearTemplateCache();
    console.error = oldError;
  }
  return logs;
}

function debugTemplateFunction(html, componentName) {
  const RealFunction = globalThis.Function;
  const oldError = console.error;
  let debug = '';
  globalThis.Function = function (...args) {
    try {
      return RealFunction(...args);
    } catch (error) {
      debug = [
        `Generated template function for <${componentName}> failed: ${error.message}`,
        '',
        args.join('\n---ARG---\n'),
      ].join('\n');
      throw error;
    }
  };
  console.error = () => {};
  try {
    clearTemplateCache();
    createTemplate(html, { name: componentName });
  } finally {
    console.error = oldError;
    globalThis.Function = RealFunction;
    clearTemplateCache();
  }
  return debug;
}

function escapeTemplateLiteral(value) {
  return String(value).replaceAll('\\', '\\\\').replaceAll('`', '\\`').replaceAll('$', '\\$');
}

function generateCompiledJS(parsed, componentName) {
  let klass = parsed.script;
  if (!/class\s+\{/.test(klass)) {
    klass = `class {\n${klass}\n}`;
  }

  if (parsed.style && parsed.style.includes(':')) {
    const css = escapeTemplateLiteral(parsed.style);
    klass = klass.replace(/\}\s*$/, `\n  CSS = \`:fez {\n${css}\n}\`\n}`);
  }
  if (parsed.styleGlobal && parsed.styleGlobal.includes(':')) {
    const cssGlobal = escapeTemplateLiteral(parsed.styleGlobal);
    klass = klass.replace(/\}\s*$/, `\n  CSS_GLOBAL = \`${cssGlobal}\`\n}`);
  }
  if (parsed.html && /\w/.test(parsed.html)) {
    const html = parsed.html.trim().replaceAll('`', '&#x60;').replaceAll('$', '\\$');
    klass = klass.replace(/\}\s*$/, `\n  HTML = \`${html}\`\n}`);
  }

  const parts = klass.split(/class\s+\{/, 2);
  const preamble = parts[0] || '';
  const classBody = parts[1] ? `class {\n${parts[1]}` : klass;
  return `${preamble.trim() ? preamble.trim() + '\n\n' : ''}Fez('${componentName}', ${classBody})`;
}

async function formatCompiledJS(code, filePath) {
  try {
    return { code: await prettier.format(code, { parser: 'babel' }) };
  } catch (error) {
    return { error: { message: firstLine(error.message), file: filePath, kind: 'Format' } };
  }
}

function printError(error) {
  const location = error.line ? `:${error.line}${error.column ? ':' + error.column : ''}` : '';
  const kind = error.kind ? `${error.kind} error: ` : '';
  console.error(`${error.file}${location}: ${kind}${error.message}`);
  if (error.detail) {
    console.error(`  Template: ${error.detail}`);
  }
  if (error.debug) {
    console.error(`\n${error.debug}`);
  }
}
