#!/usr/bin/env bun

// Build the static site plus dist bundles, then replace the whole `pages`
// branch with that output as a single rolling commit and force-push it.
//
// GitHub Pages serves the `pages` branch at its root. Source and build output
// stay on main; only this script touches the pages worktree.
//
//   bun bin/build-pages [--dry-run]
//
// --dry-run builds and commits the pages branch locally but skips the push.

import { execFileSync } from 'node:child_process';
import { cpSync, existsSync, mkdirSync, readdirSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

const argv = process.argv.slice(2);
const DRY_RUN = argv.includes('--dry-run');

const USAGE = [
  'Usage: bun bin/build-pages [--dry-run]',
  '',
  'Builds dist + the static site into tmp/fez-pages, replaces the `pages`',
  'branch with that output as a single rolling commit, and force-pushes it.',
  'Requires a clean working tree on main.',
  '',
  'Options:',
  '  --dry-run   build and commit the pages branch locally, skip the push',
  '  -h, --help  show this message',
].join('\n');

class BuildPagesError extends Error {}

const fail = (message) => {
  throw new BuildPagesError(message);
};

const tailLines = (text, count) => text.split('\n').slice(-count).join('\n');

// Run a command and capture its output. On failure the thrown error carries the
// label (what we were doing) plus the tail of stdout/stderr, so the top-level
// handler prints one clear line instead of a stack or an inherited stderr dump.
const run = (command, args, label, options = {}) => {
  let output;
  try {
    output = execFileSync(command, args, {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'pipe'],
    });
  } catch (error) {
    const combined = [error.stdout, error.stderr].map((s) => String(s || '')).join('').trim();
    const exit = typeof error.status === 'number' ? ` (exit ${error.status})` : '';
    fail(`${label} failed${exit}${combined ? '\n' + tailLines(combined, 15) : ''}`);
  }
  if (options.echo && output) {
    process.stdout.write(output);
  }
  return output;
};

const git = (...args) => run('git', args, `"git ${args.join(' ')}"`).trim();

const gitQuiet = (...args) => {
  try {
    return git(...args);
  } catch {
    return null;
  }
};

// One-line summary of a `git status --porcelain` dump.
const summarizeStatus = (text) => {
  const rows = text.split('\n').filter(Boolean);
  const untracked = rows.filter((row) => row.startsWith('??')).length;
  const staged = rows.filter((row) => !row.startsWith('??') && row[0] !== ' ').length;
  const modified = rows.filter((row) => !row.startsWith('??') && row[1] !== ' ').length;
  return `${staged} staged, ${modified} modified, ${untracked} untracked`;
};

try {
  if (argv.includes('-h') || argv.includes('--help')) {
    console.log(USAGE);
    process.exit(0);
  }

  const repoRoot = gitQuiet('rev-parse', '--show-toplevel');
  if (!repoRoot) {
    fail('not inside a git repository');
  }
  process.chdir(repoRoot);

  const branch = git('rev-parse', '--abbrev-ref', 'HEAD');
  if (branch !== 'main') {
    fail(`refusing to run on branch "${branch}" - switch to main first`);
  }

  // Preflight: never start a build unless the tree is committed, so a publish
  // always maps back to an exact source commit.
  const dirty = git('status', '--porcelain');
  if (dirty) {
    fail(`cannot build pages unless all files are committed (${summarizeStatus(dirty)})`);
  }

  console.log('build-pages: building dist bundles');
  run('bun', ['run', 'build'], '"bun run build"', { echo: true });

  console.log('build-pages: building static site -> tmp/fez-pages');
  run('bun', ['run', 'static'], '"bun run static"', { echo: true });

  const siteDir = join(repoRoot, 'tmp', 'fez-pages');
  if (!existsSync(join(siteDir, 'index.html'))) {
    fail('static build produced no index.html at ' + siteDir);
  }

  git('worktree', 'prune');

  const worktree = join(repoRoot, 'tmp', 'pages-wt');
  const pagesExists = gitQuiet('rev-parse', '--verify', '--quiet', 'refs/heads/pages') !== null;

  if (!existsSync(worktree)) {
    mkdirSync(join(repoRoot, 'tmp'), { recursive: true });
    if (pagesExists) {
      git('worktree', 'add', worktree, 'pages');
    } else {
      git('worktree', 'add', '--detach', worktree);
      git('-C', worktree, 'checkout', '--orphan', 'pages');
    }
  }

  git('-C', worktree, 'rm', '-rf', '.');
  gitQuiet('-C', worktree, 'clean', '-fd');

  let files = 0;
  for (const entry of readdirSync(siteDir)) {
    cpSync(join(siteDir, entry), join(worktree, entry), { recursive: true, force: true });
    files++;
  }

  git('-C', worktree, 'add', '-A');

  const { version } = JSON.parse(readFileSync(join(repoRoot, 'package.json'), 'utf8'));
  const mainSha = git('rev-parse', '--short', 'HEAD');
  const message = `fez-pages ${version} (${mainSha})`;
  const hasCommit = gitQuiet('-C', worktree, 'rev-parse', '--verify', '--quiet', 'HEAD') !== null;

  if (hasCommit) {
    git('-C', worktree, 'commit', '--amend', '--no-edit');
  } else {
    git('-C', worktree, 'commit', '-m', message);
  }

  const commit = git('-C', worktree, 'rev-parse', '--short', 'HEAD');
  console.log(`build-pages: pages @ ${commit} (${files} top-level entries)`);

  if (DRY_RUN) {
    console.log('build-pages: --dry-run, skipping push');
  } else {
    try {
      git('-C', worktree, 'push', '--force-with-lease', 'origin', 'pages');
    } catch (error) {
      fail(
        error.message +
          '\n  the remote may have moved: run "git fetch origin" and retry, or push with --force' +
          `\n  the local commit is kept in ${worktree}`
      );
    }
    console.log('build-pages: pushed origin/pages');
  }
} catch (error) {
  const detail =
    error instanceof BuildPagesError
      ? error.message
      : 'unexpected error: ' + (error && error.message ? error.message : String(error));
  console.error('build-pages: ' + detail);
  if (process.env.DEBUG) {
    console.error(error.stack);
  }
  process.exit(1);
}
