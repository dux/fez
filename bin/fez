#!/usr/bin/env bun

import fs from 'fs';
import path from 'path';

const binDir = path.dirname(fs.realpathSync(Bun.argv[1]));
const [command, ...args] = Bun.argv.slice(2);

if (!command || command === '--help' || command === '-h') {
  const subcommands = fs
    .readdirSync(binDir)
    .filter((name) => /^fez-[a-z0-9-]+$/.test(name) && !name.includes('.tmp.'))
    .map((file) => {
      const executable = path.join(binDir, file);
      if (!fs.statSync(executable).isFile()) {
        return null;
      }
      const result = Bun.spawnSync({
        cmd: [executable, '--info'],
        stdout: 'pipe',
        stderr: 'ignore',
      });
      return [file.slice(4), result.stdout.toString().trim()];
    })
    .filter(Boolean)
    .sort(([left], [right]) => left.localeCompare(right));

  const width = Math.max(...subcommands.map(([name]) => name.length));
  console.log('Usage: fez <command> [options]');
  console.log('');
  console.log('Commands:');
  for (const [name, info] of subcommands) {
    console.log(`  ${name.padEnd(width)}  ${info}`);
  }
  console.log('');
  console.log(`Source: ${path.dirname(binDir)}`);
  console.log('Repo:   https://github.com/dux/fez');
  console.log('Docs:   fez agents   (LLM reference, AGENTS.md)');
  console.log('');
  console.log("Run 'fez <command> --help' for details on a specific command.");
  process.exit(0);
}

if (!/^[a-z0-9][a-z0-9-]*$/.test(command)) {
  fail(command);
}

const subcommand = path.join(binDir, `fez-${command}`);
if (!fs.existsSync(subcommand) || !fs.statSync(subcommand).isFile()) {
  fail(command);
}

const child = Bun.spawn({
  cmd: [subcommand, ...args],
  stdin: 'inherit',
  stdout: 'inherit',
  stderr: 'inherit',
});
process.on('SIGTERM', () => child.kill('SIGTERM'));
process.exit(await child.exited);

function fail(name) {
  console.error(`fez: '${name}' is not a fez command. See 'fez --help'.`);
  process.exit(1);
}
