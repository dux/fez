#!/usr/bin/env bun

import { parseArgs } from 'util';
import fs from 'fs';
import path from 'path';
import { globSync } from 'glob';

const INFO =
  'Report legacy Fez syntax, removed APIs, window.Pjax calls and JavaScript modernization candidates';
const DEFAULT_PATHS = ['pages_src/root/fez', 'src', 'test'];
// Dependencies and build output are not the author's to refactor, and a bundled
// copy of an old component reports every issue a second time.
const IGNORED_DIRS = ['node_modules', 'dist', 'build', 'tmp', '.next', '.git', 'coverage', 'vendor'];
// Pjax statics that moved to Fez itself; everything else lives on Fez.pjax
const PJAX_SHORTCUTS = ['load', 'refresh'];
// Pjax URL state helpers that moved to Fez.url
const URL_HELPERS = { qs: 'qs', hash: 'hqs', hpath: 'hpath', hqs: 'hqs' };
// Removed component and Fez APIs: [pattern, message, suggestion]
const REMOVED_APIS = [
  [/\b(?:onInit|created)\s*\(\s*(?:props)?\s*\)\s*\{/, 'Removed init alias', 'Rename the hook to init(props).'],
  [/\bthis\.onWindowResize\s*\(|^\s*onWindowResize\s*\(\s*\)\s*\{/, 'Removed onWindowResize', "this.on('resize', fn, { throttle: 200 }) - it is not called on its own."],
  [/\bthis\.onWindowScroll\s*\(|^\s*onWindowScroll\s*\(\s*\)\s*\{/, 'Removed onWindowScroll', "this.on('scroll', fn, { throttle: 200 }) - call fn once yourself for the initial state."],
  [/\bthis\.onElementResize\s*\(/, 'Renamed onElementResize', 'this.observeResize(el, fn, delay)'],
  [/\bthis\.(?:addClass|toggleClass)\s*\(/, 'Removed class helper', 'Use this.root.classList.add / toggle (or the node\'s classList).'],
  [/\bthis\.fezRefresh\s*\(/, 'Removed fezRefresh', 'this.refresh()'],
  [/\bthis\.prop\s*\(/, 'Removed this.prop()', 'Read this.props.name (declare PROPS for typed values).'],
  [/\bFez\.morphdom\s*\(/, 'Removed Fez.morphdom', 'Fez.nodeMorph(target, newNode)'],
  [/\bFez\.log\s*\(/, 'Renamed Fez.log', 'Fez.dev.dump(nodeOrValue)'],
  [/\bFez\.state\.subscribe\s*\(\s*\(\s*key\b/, 'Fez.state.subscribe callback order changed', 'The all-keys callback is (value, oldValue, key), like the per-key one.'],
  [/\bon[a-z]+="\{\s*\(?[\w\s,]*\)?\s*=>/, 'Quoted arrow handler is a no-op', 'Drop the quotes: onclick={() => save()}'],
  [/\b(?:this|fez)\.local\b/, 'Removed this.local', 'Use this.state: a key the template never reads costs no render.'],
  [/<slot\s(?:[^>]*\s)?live(?=[\s>\/=])/, 'Removed <slot live />', 'Slots are live by default: write <slot />, or <slot rebuild /> for a fresh component per change.'],
  [/\bFez\.clearFetchCache\s*\(/, 'Removed Fez.clearFetchCache', 'Fez.req.clearCache()'],
  [/\bFez\.(?:pjax\.)?(?:qs|hash|hpath|hqs)\s*\(/, 'Removed Fez.qs / hash / hpath / hqs', "Fez.url.qs('k') reads; Fez.url.qs('k', v) builds - finish with .push(), .replace() or String(...). Fez.hash -> Fez.url.hqs; Fez.url.hpath() is the full route path ('/logs')."],
  [/\bFez\.(?:htmlEscape|htmlAttr|jsEscape|styleProp|isTrue|isTruthy|typeof|toPairs|throttle|fnv1|uid|darkenColor|lightenColor|untilTrue|onReady)\b/, 'Moved Fez.<util> to Fez.util', 'Fez.util.<name>, for example Fez.util.htmlEscape(value).'],
  [/\bFez\.(?:POINTER(?:_SEQ|_CREATED)?|sweepPointers|fezAwait|stripGeneratedNotice|_nonce)\b/, 'Moved Fez internals under Fez._', 'Framework internals live on Fez._ (Fez._.POINTER, Fez._.fezAwait, ...); use Fez.pointer(fn) and Fez.nonce() instead.'],
  [/\bFez\.fetch\s*\(/, 'Removed Fez.fetch', "Fez.req(url, { cache: 300 }) resolves { ok, status, data } and never rejects: check res.ok. POST: Fez.req(url, { method: 'POST', data })."],
  [/\bFez\.param\s*\(/, 'Moved Fez.param', 'Fez.req.param(obj)'],
  [/\bFez\.request\b/, 'Renamed Fez.request', 'Fez.req (Fez.req(url, opts), Fez.req.headers, Fez.req.clearCache(), Fez.req.param(obj)).'],
  [/\bFez\.(?:cssClass|globalCss|cssMixin|extractCss)\b/, 'Moved Fez CSS helpers under Fez.css', 'Fez.css(text) (was cssClass), Fez.css.global(css, opts), Fez.css.mixin(name, body), Fez.css.extract().'],
  [/\bFez\.(?:dump|highlightAll)\b/, 'Moved Fez.dump / highlightAll under Fez.dev', 'Fez.dev.dump(nodeOrValue), Fez.dev.highlightAll().'],
  [/\bFez\.(?:activateNode|animateSize)\b/, 'Moved Fez.<helper> to Fez.util', 'Fez.util.activateNode(node, klass), Fez.util.animateSize(node, spec).'],
  [/\bFez\.(?:instances|instanceCount|nameFromPath|createTemplate|consoleLog|consoleError|runScript|domRoot)\b/, 'Moved Fez runtime helpers under Fez._', 'Framework internals live on Fez._ (Fez._.instances, Fez._.createTemplate, ...); prefer Fez(uid), Fez.find, Fez.compile and Fez.head.'],
];
// `var` where a statement can start; after a word it is prose ("so the var drops")
const VAR_DECLARATION = /(?:(?:^|[;{}()>"'`])\s*|\bexport\s+)var\s+[A-Za-z_$]/;

let values, positionals;
try {
  ({ values, positionals } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      help: { type: 'boolean', short: 'h' },
      info: { type: 'boolean' },
    },
    allowPositionals: true,
  }));
} catch (error) {
  console.error(
    `fez refactor: ${firstLine(error.message)}. Automatic fixes are intentionally unavailable.`,
  );
  process.exit(1);
}

if (values.info) {
  console.log(INFO);
  process.exit(0);
}

if (values.help) {
  console.log(`Usage: fez refactor [path-or-glob ...]

${INFO}

This command is report-only. It never changes files.
Without paths it scans: ${DEFAULT_PATHS.join(', ')}`);
  process.exit(0);
}

const collection = collectFiles(positionals.length ? positionals : DEFAULT_PATHS);
if (collection.errors.length) {
  collection.errors.forEach((error) => console.error(`fez refactor: ${error}`));
  process.exit(1);
}

const issues = collection.files.flatMap(auditFile);
if (!issues.length) {
  console.log(`Scanned ${collection.files.length} files: no refactor candidates found`);
  process.exit(0);
}

for (const issue of issues) {
  console.log(`${issue.file}:${issue.line}: ${issue.message}`);
  console.log(`  ${issue.suggestion}`);
}
console.log(`Found ${issues.length} refactor candidates in ${collection.files.length} files`);
process.exit(1);

function collectFiles(inputs) {
  const files = [];
  const errors = [];

  for (const input of inputs) {
    if (/[*?\[\]{}]/.test(input)) {
      const matches = globSync(input, { nodir: true });
      if (!matches.length) {
        errors.push(`${input}: no files matched`);
      }
      files.push(...matches);
      continue;
    }

    try {
      const stat = fs.statSync(input);
      if (stat.isDirectory()) {
        files.push(
          ...globSync('**/*.{fez,js,ts}', {
            cwd: input,
            absolute: true,
            nodir: true,
            ignore: IGNORED_DIRS.map((dir) => `**/${dir}/**`),
          }),
        );
      } else if (stat.isFile()) {
        files.push(path.resolve(input));
      }
    } catch (error) {
      errors.push(
        `${input}: ${error.code === 'ENOENT' ? 'path not found' : firstLine(error.message)}`,
      );
    }
  }

  return {
    files: [...new Set(files)]
      .filter((file) => /\.(fez|js|ts)$/.test(file))
      .filter((file) => !path.basename(file).includes('.tmp.'))
      .sort(),
    errors,
  };
}

function auditFile(file) {
  const content = fs.readFileSync(file, 'utf-8');
  const lines = content.split('\n');
  const isFez = file.endsWith('.fez');
  const issues = [];
  const report = (line, message, suggestion) =>
    issues.push({ file: displayPath(file), line, message, suggestion });

  // the pjax lib and its tests bind their own Pjax - only globals are legacy
  const ownsPjax = /\b(?:class|let|const|var)\s+Pjax\b|function\s*\w*\s*\(\s*Pjax\s*\)/.test(content);

  let inStyle = false;
  for (let index = 0; index < lines.length; index++) {
    const line = lines[index];
    if (isFez && /^\s*<style\b/.test(line)) {
      // a one-line <style>...</style> closes right here
      inStyle = !/<\/style>/.test(line);
    } else if (isFez && /<\/style>/.test(line)) {
      inStyle = false;
    } else if (inStyle && /^\s*\/\//.test(line)) {
      report(index + 1, '// comment in <style>', 'CSS has no line comments - use /* ... */.');
    }
    for (const [pattern, message, suggestion] of REMOVED_APIS) {
      if (pattern.test(line)) {
        report(index + 1, message, suggestion);
      }
    }
    if (!ownsPjax && /\bPjax\./.test(stripLineComment(line))) {
      report(index + 1, 'Legacy window.Pjax call', pjaxSuggestion(line));
    }
    if (isFez && /\{\{[\s#/]*/.test(line)) {
      report(
        index + 1,
        'Legacy {{ ... }} Fez syntax',
        'Migrate this expression or block to the documented single-brace syntax.',
      );
    }
    if (VAR_DECLARATION.test(stripLineComment(line))) {
      report(index + 1, 'Legacy var declaration', 'Review assignments and choose const or let manually.');
    }
  }

  return issues;
}

function pjaxSuggestion(line) {
  const hints = [];
  for (const [, name] of line.matchAll(/\bPjax\.(\w+)/g)) {
    if (name === 'reload') {
      hints.push('Pjax.reload -> Fez.refresh');
    } else if (URL_HELPERS[name]) {
      hints.push(`Pjax.${name} -> Fez.url.${URL_HELPERS[name]}`);
    } else if (PJAX_SHORTCUTS.includes(name)) {
      hints.push(`Pjax.${name} -> Fez.${name}`);
    } else {
      hints.push(`Pjax.${name} -> Fez.pjax.${name}`);
    }
  }
  // load options only; the URL state helpers keep their own `replace` option
  if (/\bPjax\.(?:load|refresh|reload)\b/.test(line)) {
    if (/\bajax\s*:/.test(line)) {
      hints.push('ajax: -> source:');
    }
    if (/\breplace\s*:\s*true\b/.test(line)) {
      hints.push("replace: true -> history: 'replace'");
    }
    if (/\bdone\s*:/.test(line)) {
      hints.push('done: fn -> .then(fn)');
    }
  }
  return [...new Set(hints)].join('; ');
}

function stripLineComment(line) {
  return line.replace(/\/\/.*$/, '');
}

function displayPath(file) {
  const relative = path.relative(process.cwd(), file);
  return relative.startsWith('..') ? file : relative;
}

function firstLine(message) {
  return String(message || 'Unknown error').split('\n')[0];
}
