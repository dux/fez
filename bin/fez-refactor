#!/usr/bin/env bun

import { parseArgs } from 'util';
import fs from 'fs';
import path from 'path';
import { globSync } from 'glob';

const INFO = 'Report legacy Fez syntax and JavaScript modernization candidates';
const DEFAULT_PATHS = ['docs_src/root/fez', 'src', 'test'];
// Dependencies and build output are not the author's to refactor, and a bundled
// copy of an old component reports every issue a second time.
const IGNORED_DIRS = ['node_modules', 'dist', 'build', 'tmp', '.next', '.git', 'coverage', 'vendor'];

let values, positionals;
try {
  ({ values, positionals } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      help: { type: 'boolean', short: 'h' },
      info: { type: 'boolean' },
    },
    allowPositionals: true,
  }));
} catch (error) {
  console.error(
    `fez refactor: ${firstLine(error.message)}. Automatic fixes are intentionally unavailable.`,
  );
  process.exit(1);
}

if (values.info) {
  console.log(INFO);
  process.exit(0);
}

if (values.help) {
  console.log(`Usage: fez refactor [path-or-glob ...]

${INFO}

This command is report-only. It never changes files.
Without paths it scans: ${DEFAULT_PATHS.join(', ')}`);
  process.exit(0);
}

const collection = collectFiles(positionals.length ? positionals : DEFAULT_PATHS);
if (collection.errors.length) {
  collection.errors.forEach((error) => console.error(`fez refactor: ${error}`));
  process.exit(1);
}

const issues = collection.files.flatMap(auditFile);
if (!issues.length) {
  console.log(`Scanned ${collection.files.length} files: no refactor candidates found`);
  process.exit(0);
}

for (const issue of issues) {
  console.log(`${issue.file}:${issue.line}: ${issue.message}`);
  console.log(`  ${issue.suggestion}`);
}
console.log(`Found ${issues.length} refactor candidates in ${collection.files.length} files`);
process.exit(1);

function collectFiles(inputs) {
  const files = [];
  const errors = [];

  for (const input of inputs) {
    if (/[*?\[\]{}]/.test(input)) {
      const matches = globSync(input, { nodir: true });
      if (!matches.length) {
        errors.push(`${input}: no files matched`);
      }
      files.push(...matches);
      continue;
    }

    try {
      const stat = fs.statSync(input);
      if (stat.isDirectory()) {
        files.push(
          ...globSync('**/*.{fez,js,ts}', {
            cwd: input,
            absolute: true,
            nodir: true,
            ignore: IGNORED_DIRS.map((dir) => `**/${dir}/**`),
          }),
        );
      } else if (stat.isFile()) {
        files.push(path.resolve(input));
      }
    } catch (error) {
      errors.push(
        `${input}: ${error.code === 'ENOENT' ? 'path not found' : firstLine(error.message)}`,
      );
    }
  }

  return {
    files: [...new Set(files)]
      .filter((file) => /\.(fez|js|ts)$/.test(file))
      .filter((file) => !path.basename(file).includes('.tmp.'))
      .sort(),
    errors,
  };
}

function auditFile(file) {
  const content = fs.readFileSync(file, 'utf-8');
  const lines = content.split('\n');
  const isFez = file.endsWith('.fez');
  const issues = [];
  const report = (line, message, suggestion) =>
    issues.push({ file: displayPath(file), line, message, suggestion });

  for (let index = 0; index < lines.length; index++) {
    const line = lines[index];
    if (isFez && /\{\{[\s#/]*/.test(line)) {
      report(
        index + 1,
        'Legacy {{ ... }} Fez syntax',
        'Migrate this expression or block to the documented single-brace syntax.',
      );
    }
    if (/\bvar\s+[A-Za-z_$]/.test(stripLineComment(line))) {
      report(index + 1, 'Legacy var declaration', 'Review assignments and choose const or let manually.');
    }
    if (/^\s*(?:static\s+)?FAST\s*=/.test(stripLineComment(line))) {
      report(
        index + 1,
        'FAST was removed in 0.5.3',
        'Nothing reads it. Delete the line - every render is next-frame now.',
      );
    }
  }

  if (isFez) {
    issues.push(...auditSingleton(content, file));
    issues.push(...auditRedundantRefs(content, file));
  }

  return issues;
}

// GLOBAL used to mean "auto-mount and expose"; since the MOUNT split it only
// names the window handle. A component relying on the old auto-mount is never
// appended to body, with no console output at all.
function auditSingleton(content, file) {
  if (/^\s*(?:static\s+)?MOUNT\s*=/m.test(content)) {
    return [];
  }
  const index = content.search(/^\s*(?:static\s+)?GLOBAL\s*=\s*['"]/m);
  if (index < 0) {
    return [];
  }
  return [
    {
      file: displayPath(file),
      line: content.slice(0, index).split('\n').length,
      message: 'GLOBAL without MOUNT no longer auto-mounts',
      suggestion: 'Add MOUNT = true if the page does not place this tag itself.',
    },
  ];
}

// fez:this refs land in this.state on their own; a matching this.name = find()
// still works but re-does the lookup and hides which store the ref lives in.
function auditRedundantRefs(content, file) {
  const issues = [];
  const refs = new Set([...content.matchAll(/fez[:-]this="([A-Za-z_$][\w$]*)"/g)].map((m) => m[1]));

  for (const ref of refs) {
    const match = content.match(new RegExp(`^.*\\bthis\\.${ref}\\s*=[^=].*$`, 'm'));
    if (!match) {
      continue;
    }
    issues.push({
      file: displayPath(file),
      line: content.slice(0, match.index).split('\n').length,
      message: `Redundant assignment to a fez:this ref: ${ref}`,
      suggestion: `Drop the lookup - the ref is already delivered as this.state.${ref}.`,
    });
  }

  return issues;
}

function stripLineComment(line) {
  return line.replace(/\/\/.*$/, '');
}

function displayPath(file) {
  const relative = path.relative(process.cwd(), file);
  return relative.startsWith('..') ? file : relative;
}

function firstLine(message) {
  return String(message || 'Unknown error').split('\n')[0];
}
