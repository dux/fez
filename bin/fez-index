#!/usr/bin/env bun

import { parseArgs } from 'util';
import fs from 'fs';
import path from 'path';
import { globSync } from 'glob';

const INFO = 'Generate JSON index of files in directories, paths, or globs';

let values, positionals;
try {
  ({ values, positionals } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      help: { type: 'boolean', short: 'h' },
      info: { type: 'boolean' },
    },
    allowPositionals: true,
  }));
} catch (error) {
  console.error(`fez index: ${firstLine(error.message)}. See 'fez index --help'.`);
  process.exit(1);
}

if (values.info) {
  console.log(INFO);
  process.exit(0);
}

if (values.help || positionals.length === 0) {
  console.log(`Usage: fez index <directory-or-path> [more-paths ...]

${INFO}

Examples:
  fez index demo/fez
  fez index demo/fez/*.fez
  fez index 'assets/**/*.{js,css}'`);
  process.exit(0);
}

const files = [];
const errors = [];
for (const input of positionals) {
  if (/[*?\[\]{}]/.test(input)) {
    const matches = globSync(input, { nodir: true });
    if (!matches.length) {
      errors.push(`${input}: no files matched`);
    }
    files.push(...matches);
    continue;
  }

  try {
    const stat = fs.statSync(input);
    if (stat.isDirectory()) {
      files.push(...fs.readdirSync(input).map((name) => path.join(input, name)));
    } else if (stat.isFile()) {
      files.push(input);
    }
  } catch (error) {
    errors.push(
      `${input}: ${error.code === 'ENOENT' ? 'path not found' : firstLine(error.message)}`,
    );
  }
}

if (errors.length) {
  errors.forEach((error) => console.error(`fez index: ${error}`));
  process.exit(1);
}

const index = [];
for (const file of [...new Set(files)].sort()) {
  if (path.basename(file).includes('.tmp.')) {
    continue;
  }
  let stat;
  try {
    stat = fs.statSync(file);
  } catch {
    continue;
  }
  if (!stat.isFile()) {
    continue;
  }

  const created = stat.birthtimeMs > 0 ? stat.birthtimeMs : stat.ctimeMs;
  index.push({
    file: {
      base: path.basename(file, path.extname(file)),
      path: file,
      size: stat.size,
      modified: Math.floor(stat.mtimeMs / 1000),
      created: Math.floor(created / 1000),
    },
  });
}

console.log(JSON.stringify(index, null, 2));

function firstLine(message) {
  return String(message || 'Unknown error').split('\n')[0];
}
