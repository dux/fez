#!/usr/bin/env bun

import { parseArgs } from 'util'
import fs from 'fs'
import path from 'path'

const INFO = 'Print AGENTS.md - Fez reference for LLM agents'
const REPO = 'https://github.com/dux/fez'
const MARKER = /^# Fez JS lib Quick Reference for AI Assistants/

// realpath so the npm bin symlink resolves to the package dir
const root = path.dirname(path.dirname(fs.realpathSync(Bun.argv[1])))
const agentsMd = path.join(root, 'AGENTS.md')

const POINTER = `## Fez components (.fez files)

This project uses Fez (${REPO}) for \`.fez\` DOM components.
Before writing or editing \`.fez\` files, run \`fez agents\` and follow that reference.
Validate components with \`fez compile <file.fez>\`; \`fez --help\` lists all commands.
`

let values, positionals
try {
  ;({ values, positionals } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      help: { type: 'boolean', short: 'h' },
      full: { type: 'boolean' },
      init: { type: 'boolean' },
      info: { type: 'boolean' },
    },
    allowPositionals: true,
  }))
} catch (e) {
  console.error(`fez agents: ${e.message.split('.')[0]}. See 'fez agents --help'.`)
  process.exit(1)
}

if (values.info) {
  console.log(INFO)
  process.exit(0)
}

if (values.help || positionals.length > 0) {
  console.log(`Usage: fez agents [--full | --init]

${INFO}

Options:
  (none)   Print the LLM reference (skips the fez-repo-local section)
  --full   Print the whole AGENTS.md verbatim
  --init   Add a pointer block to ./AGENTS.md (and ./CLAUDE.md if present)
           telling agents in this project to run 'fez agents'

Source: ${root}
Repo:   ${REPO}`)
  process.exit(positionals.length > 0 ? 1 : 0)
}

if (!fs.existsSync(agentsMd)) {
  console.error(`fez agents: ${agentsMd} not found`)
  process.exit(1)
}

// append pointer block to a project-level agent file, skip if already referenced
const initFile = (file, { skipIf, create = true }) => {
  if (fs.existsSync(file)) {
    const content = fs.readFileSync(file, 'utf8')
    if (skipIf.some(s => content.includes(s))) {
      console.log(`${file}: already references fez, skipped`)
      return
    }
    const sep = content.endsWith('\n') ? '\n' : '\n\n'
    fs.writeFileSync(file, content + sep + POINTER)
    console.log(`${file}: appended fez pointer block`)
  } else if (create) {
    fs.writeFileSync(file, POINTER)
    console.log(`${file}: created with fez pointer block`)
  }
}

if (values.init) {
  initFile('AGENTS.md', { skipIf: ['fez agents'] })
  initFile('CLAUDE.md', { skipIf: ['fez agents', '@AGENTS.md'], create: false })
} else if (values.full) {
  process.stdout.write(fs.readFileSync(agentsMd, 'utf8'))
} else {
  const lines = fs.readFileSync(agentsMd, 'utf8').split('\n')
  const start = Math.max(0, lines.findIndex(l => MARKER.test(l)))
  console.log(`<!-- Fez source: ${root} | repo: ${REPO} | full file: fez agents --full -->`)
  console.log('')
  process.stdout.write(lines.slice(start).join('\n'))
}
