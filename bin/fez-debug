#!/usr/bin/env bun

import { parseArgs } from 'util';
import readline from 'node:readline';
import { inspect } from 'node:util';

const INFO = 'Open a URL in Playwright with an interactive debugging REPL';

let values, positionals;
try {
  ({ values, positionals } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      help: { type: 'boolean', short: 'h' },
      headless: { type: 'boolean' },
      info: { type: 'boolean' },
    },
    allowPositionals: true,
  }));
} catch (error) {
  console.error(`fez debug: ${firstLine(error.message)}. See 'fez debug --help'.`);
  process.exit(1);
}

if (values.info) {
  console.log(INFO);
  process.exit(0);
}

if (values.help || positionals.length === 0) {
  console.log(`Usage: fez debug [--headless] <url>

${INFO}

The REPL exposes page, browser, and context and supports await expressions.
Exit with .exit or Ctrl+D.

Example:
  fez debug http://localhost:3333`);
  process.exit(0);
}

if (positionals.length !== 1) {
  console.error("fez debug: expected exactly one URL. See 'fez debug --help'.");
  process.exit(1);
}

let url;
try {
  url = new URL(positionals[0]);
  if (!['http:', 'https:', 'file:'].includes(url.protocol)) {
    throw new Error('Unsupported URL protocol');
  }
} catch (error) {
  console.error(`fez debug: invalid URL '${positionals[0]}': ${firstLine(error.message)}`);
  process.exit(1);
}

let chromium;
try {
  ({ chromium } = await import('playwright'));
} catch {
  console.error('fez debug: Playwright is unavailable. Reinstall @dinoreic/fez.');
  process.exit(1);
}

let browser;
try {
  browser = await chromium.launch({ headless: values.headless });
  const context = await browser.newContext();
  const page = await context.newPage();
  await page.goto(url.href);

  Object.assign(globalThis, { page, browser, context });
  console.log(`Page loaded: ${url.href}`);
  console.log('Globals: page, browser, context');
  await startRepl({ page, browser, context });
} catch (error) {
  console.error(`fez debug: ${firstLine(error.message)}`);
  process.exitCode = 1;
} finally {
  await browser?.close();
}

function firstLine(message) {
  return String(message || 'Unknown error').split('\n')[0];
}

async function startRepl(scope) {
  const input = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    terminal: Boolean(process.stdin.isTTY),
  });

  const AsyncFunction = Object.getPrototypeOf(async function () {}).constructor;
  const names = Object.keys(scope);
  const values = Object.values(scope);

  const prompt = () => {
    if (process.stdin.isTTY) {
      input.prompt();
    }
  };

  input.setPrompt('fez> ');
  prompt();
  for await (const line of input) {
    if (line.trim() === '.exit') {
      input.close();
      break;
    }
    if (!line.trim()) {
      prompt();
      continue;
    }

    try {
      const evaluate = compileInput(AsyncFunction, names, line);
      const result = await evaluate(...values);
      if (result !== undefined) {
        console.log(inspect(result, { colors: Boolean(process.stdout.isTTY), depth: 5 }));
      }
    } catch (error) {
      console.error(error.stack || error.message || String(error));
    }
    prompt();
  }
}

function compileInput(AsyncFunction, names, input) {
  try {
    return new AsyncFunction(...names, `return (${input}\n)`);
  } catch (error) {
    if (!(error instanceof SyntaxError)) {
      throw error;
    }
    return new AsyncFunction(...names, input);
  }
}
