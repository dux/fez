#!/usr/bin/env bun

import { parseArgs } from 'util';
import fs from 'fs';
import path from 'path';
import { formatVersion } from '../src/fez/lib/version.js';

const INFO = 'Print the Fez version (v<main commit count> from .version, dotted)';

let values;
try {
  ({ values } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      help: { type: 'boolean', short: 'h' },
      raw: { type: 'boolean' },
      info: { type: 'boolean' },
    },
  }));
} catch (error) {
  console.error(`fez version: ${error.message.split('\n')[0]}. See 'fez version --help'.`);
  process.exit(1);
}

if (values.info) {
  console.log(INFO);
  process.exit(0);
}

if (values.help) {
  console.log(`Usage: fez version [--raw]

${INFO}

Options:
  -h, --help  Show this help message
  --raw       Print the stamp as stored (v357) instead of dotted (v3.5.7)

A checkout that was never stamped by 'bun run deploy' prints dev.`);
  process.exit(0);
}

// realpath so the npm bin symlink resolves to the package dir
const file = path.join(path.dirname(path.dirname(fs.realpathSync(Bun.argv[1]))), '.version');
const raw = fs.existsSync(file) ? fs.readFileSync(file, 'utf8').trim() || 'dev' : 'dev';
console.log(values.raw ? raw : formatVersion(raw));
