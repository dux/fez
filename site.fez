<!-- generated from src: pages_src/root/site.fez | DO NOT EDIT OR READ THIS FILE -->
<xmp fez="site-nav">
  <script>
    class {
      NAME = 'nav'

      init() {
        this.state.path = this.currentPage()
        this.state.menuOpen = false
        this.state.links = [
          { href: 'index.html',     name: 'index.html',    label: 'Home' },
          { href: 'features.html',  name: 'features.html', label: 'Features' },
          { href: 'changelog/',     name: 'changelog',     label: 'Changelog' },
          { href: 'examples.html',  name: 'examples.html', label: 'Examples' },
          // the playground loads page-specific editor assets, so enter it with a full navigation
          { href: 'playground.html', name: 'playground.html', label: 'Playground', full: true },
          { href: 'docs.html',      name: 'docs.html',     label: 'Docs' },
          { href: 'static.html',    name: 'static.html',   label: 'Site generator' },
          { href: 'dist.html',      name: 'dist.html',     label: 'Dist' },
          { href: 'https://github.com/dux/fez', label: 'GitHub', ext: true },
        ]
      }

      onMount() {
        // pjax swaps only <main>; the nav lives outside it and follows the url
        this.on('pjax:render', () => {
          this.state.path = this.currentPage()
          this.state.menuOpen = false
        })

        // mobile menu closes on link click or a click outside the nav
        this.on(this.root, 'click', (e) => {
          if (e.target.closest('a')) this.state.menuOpen = false
        })
        this.on(document, 'click', (e) => {
          if (this.state.menuOpen && !this.root.contains(e.target)) this.state.menuOpen = false
        })
      }

      toggleMenu() {
        this.state.menuOpen = !this.state.menuOpen
      }

      currentPage() {
        const last = location.pathname.replace(/\/$/, '').split('/').pop()
        return last || 'index.html'
      }
    }
  </script>

  <div class="site-wrap {state.path == 'playground.html' ? 'no-pjax' : ''}">
    <a class="brand" href="index.html">
      <img src="fez.png" alt="" />
      <span class="brand-copy">
        <strong>Fez</strong>
        <small>DOM / single-page / no-compile components</small>
      </span>
    </a>
    <button
      class="nav-burger"
      class:open={state.menuOpen}
      aria-label="Menu"
      aria-expanded={state.menuOpen ? 'true' : 'false'}
      onclick="fez.toggleMenu()"
    >
      <span></span><span></span><span></span>
    </button>
    <ul class:open={state.menuOpen}>
      {#each state.links as link}
        <li>
          {#if link.ext}
            <a href="{link.href}" class="ext no-pjax" target="_blank">{link.label}</a>
          {:else if link.full}
            <a href="{link.href}" class="no-pjax {link.name == state.path ? 'active' : ''}">{link.label}</a>
          {:else}
            <a href="{link.href}" class="{link.name == state.path ? 'active' : ''}">{link.label}</a>
          {/if}
        </li>
      {/each}
    </ul>
  </div>
</xmp>

