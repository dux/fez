<info>
  <ul>
    <li>Colour mixer - three sliders drive one swatch</li>
    <li><code>fez:bind</code> for two-way input binding, no change handler</li>
    <li>Derived state in <code>beforeRender()</code> - the Fez answer to memos and runes</li>
    <li>Every slider track is repainted from the other two channels, so the whole panel reacts to a single drag</li>
    <li>Attribute interpolation: one <code>{#each}</code> writes all three <code>fez:bind</code> targets</li>
  </ul>
</info>

<demo>
  <ui-mixer color="#0ea5e9"></ui-mixer>
</demo>

<script>
  const hex = (r, g, b) => '#' + [r, g, b].map(n => (+n).toString(16).padStart(2, '0')).join('')

  class {
    PROPS = { color: { type: String, default: '#0ea5e9' } }

    init({ color }) {
      const [r, g, b] = color.match(/\w\w/g).map(h => parseInt(h, 16))
      Object.assign(this.state, { r, g, b })
    }

    beforeRender() {
      const { r, g, b } = this.state
      this.state.hex = hex(r, g, b)
      // each track shows what this channel does, given the other two
      this.state.track = {
        r: [hex(0, g, b), hex(255, g, b)],
        g: [hex(r, 0, b), hex(r, 255, b)],
        b: [hex(r, g, 0), hex(r, g, 255)],
      }
      this.state.light = (r * 299 + g * 587 + b * 114) / 1000 > 140
    }

    copy() {
      navigator.clipboard?.writeText(this.state.hex)
      this.state.copied = true
      setTimeout(() => (this.state.copied = false), 1200)
    }
  }
</script>

<style>
  display: grid;
  gap: 10px;
  width: 100%;

  .swatch {
    display: grid;
    place-content: center;
    gap: 2px;
    height: 116px;
    border-radius: 12px;
    background: var(--c);
    box-shadow: 0 18px 40px -14px var(--c);
    color: #fff;
    text-align: center;
    cursor: pointer;
    transition: box-shadow 0.25s;

    b {
      font-size: 26px;
      font-weight: 600;
      letter-spacing: 0.5px;
      font-variant-numeric: tabular-nums;
    }

    small {
      font-size: 12px;
      opacity: 0.75;
    }

    &.is-light {
      color: #111;
    }
  }

  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 12px;
    margin: 0;
    border-radius: 999px;
    /* --track holds both stops - "#0e00e9,#0effe9" - so the var drops
       straight into the gradient */
    background: linear-gradient(90deg, var(--track));
    cursor: ew-resize;

    &::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid rgba(0, 0, 0, 0.18);
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    }

    &::-moz-range-thumb {
      width: 20px;
      height: 20px;
      border: 1px solid rgba(0, 0, 0, 0.18);
      border-radius: 50%;
      background: #fff;
    }
  }
</style>

<div class="swatch {state.light ? 'is-light' : ''}"
     style="--c: {state.hex}" onclick="fez.copy()">
  <b>{state.hex}</b>
  <small>{state.copied ? 'copied' : 'click to copy'}</small>
</div>

{#each ['r', 'g', 'b'] as ch}
  <input key={ch} type="range" min="0" max="255"
         fez:bind="state.{ch}" style="--track: {state.track[ch]}" />
{/each}
