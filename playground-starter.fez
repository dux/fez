<demo>
  <my-clock city="Zagreb" zone="Europe/Zagreb"></my-clock>
  <my-clock city="New York" zone="America/New_York" ampm></my-clock>
</demo>

<script>
  class {
    PROPS = {
      city: { type: String, default: 'Local time' },
      zone: String,                          // IANA zone, empty is the browser zone
      ampm: { type: Boolean, state: true },  // seeds state.ampm, the button flips it
    }

    init() {
      this.tick()
      this.setInterval(() => this.tick(), 1000)
    }

    tick() {
      this.state.now = new Date()
    }

    toggle() {
      this.state.ampm = !this.state.ampm
    }

    format(options) {
      return this.state.now.toLocaleString('en-GB', { timeZone: this.props.zone, ...options })
    }
  }
</script>

<style>
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin: 6px 10px 6px 0;
  padding: 10px 14px;
  border: 1px solid #ddd;
  border-radius: 10px;
  font-size: 16px;

  b {
    font: 600 22px/1 ui-monospace, monospace;
    font-variant-numeric: tabular-nums;
  }

  small {
    color: #888;
  }

  button {
    padding: 4px 8px;
    border: 1px solid #ccc;
    border-radius: 8px;
    background: #fff;
    font-size: 13px;
    cursor: pointer;

    &:hover { border-color: #c8102e; color: #c8102e; }
  }
</style>

<b>{format({ hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: state.ampm })}</b>
<small>{props.city} - {format({ weekday: 'short', day: 'numeric', month: 'short' })}</small>
<button onclick="fez.toggle()">{state.ampm ? '24h' : '12h'}</button>
